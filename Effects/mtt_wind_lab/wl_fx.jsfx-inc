// Breeze's insert rack: the topology around the shared FX modules (mtt_fx_*.jsfx-inc, vendored
// from lib/fx/; API card in lib/README.md). Config: type, mix, A, B, C, enabled (23 x 6).
// Every slot runs one lane per array channel (lane = slot * 12 + channel, 276 lanes), all at
// the host rate. Breeze-specific here: visibility and routing of the slots (wl_routes,
// wl_rack), one IR entry per slot with spectra shared by its channels, the channels of a slot
// sharing one Curve Volume modulation and one Resonance Suppressor cut, and Delay/Reverb
// damping up to 48 kHz. Chain orchestration: wl_rack.jsfx-inc.
// All functions use local temporaries; @gfx only writes the configuration bank.
@init
// Breeze assigns one stable IR entry to each rack slot.
function conv_entry(slot) (floor(slot););
// Resonance Suppressor lane (FX type 11). The last active capsule links the maximum cut across
// the slot. All channels advance their filter ramps on the next sample, so identical signals
// remain identical.
function sup_run(k,q,base,x,age,r,amt,lo,hi) local(na,g,aa,ar,j,t,u,o,pb,c) (
  sup_step(q,base,x,age,r,amt,lo,hi) ? (
    na=q[9];
    k%12==arr_n-1 ? (
      g=floor(k/12)*12; aa=sup_attack(q,r); ar=sup_release(q,r);
      j=0; loop(na,
        t=0; u=0; loop(arr_n,
          o=fx_st+(g+u)*32; pb=fx_buf+(g+u)*FX_STRIDE;
          CHF[u]!=3 && o[0]==11 && o[7]>0 ? t=max(t,pb[3072+j]); u+=1;
        );
        c=sup_gain(base,j,t,aa,ar);
        u=0; loop(arr_n, sup_set(fx_buf+(g+u)*FX_STRIDE,j,c); u+=1;);
        j+=1;
      );
    );
  );
  sup_bells(q,base,x);
);
function fx_validate() (fx_cfg_validate(23););
// Targets are copied once per block. Runtime state is owned by the audio thread.
function fx_prepare() local(k,q,p,t,r,n,a,b,c) (
  memset(fx_on,0,7); conv_cnt=0;
  k=0; loop(276,
    n=floor(k/12); p=fx_cfg+n*6; q=fx_st+k*32;
    t=max(0,min(11,floor(p[0]))); r=srate;
    // Empty lanes have no targets to decode or histories to advance.
    (t>0 || q[0]>0 || q[1]>0) ? (
    a=max(0,min(1,p[2])); b=max(0,min(1,p[3])); c=max(0,min(1,p[4]));
    // Compatibility for old in-memory settings; audio never writes the bank.
    t==7 ? (t=8; a=log((40*300^a)/20)/log(800); b*=24/128; c*=log(16)/log(64););
    // Convolver engines are handed out in lane order; a lane without one (or whose slot has no IR
    // yet) passes the signal. Each engine follows its slot's own impulse response; odd channels
    // (R, Rs, Rss, Rrs, Rtf, Rtr) play the right channel of a stereo IR.
    // (Kept in conv_tab[4800 + lane] and [5120 + lane], not in the lane's state: other types use it.)
    conv_tab[4800+k]=-1; conv_tab[5120+k]=0;
    (t==10 || q[0]==10) && (FX_VISIBLE[n] || q[0]==10) && (q[0]==10 || (q[0]==0 && q[1]==0)) && k%12<arr_n && CHF[k%12]!=3 ? (
      conv_tab[4800+k]=k;conv_cnt+=1;
      conv_tab[5120+k]=conv_sync(k,k,conv_entry(n),k%12==1 || k%12==5 || k%12==7 || k%12==9 || k%12==11,r,(p[5]>=.5 && p[1]>0) || q[1]>.000001);
    );
    q[16]=t;q[17]=t>0 && p[5]>=.5 && FX_VISIBLE[n] && slider(229+wfx_owner(n))>=.5 && FX_ROUTE[n]==wfx_route(n) ? max(0,min(1,p[1])) : 0;
    fx_lane_targets(q,t,r,a,b,c,48000);
    (t>0 && q[17]>0) || q[1]>.000001 ? fx_on[FX_ROUTE[n]]=1;
    );
    k+=1;
  );
);
// One sample of lane k (slot k / 12, channel k % 12).
function fx_lane(k,x,pressure_mode) local(q,t,base,s,n,y) (
  q=fx_st+k*32;
  fx_lane_begin(q) ? (
    t=q[0]; base=fx_buf+k*FX_STRIDE; s=floor(k/12);
    // Curve Volume: channel 0 of the slot leads the shared modulation (FX_MOD + slot * 4).
    y=t==9 ? fx_curvevol_run(q,x,fx_curve+s*65,FX_MOD+s*4,k%12==0) :
      t==10 ? (
        // One independent convolver history per active capsule, all at host rate. IR channel
        // assignment follows the physical left/right channel names; no IR passes dry.
        n=conv_tab[4800+k];
        n>=0 && conv_tab[5120+k]==1 ? fx_convolver_run(q,x,n,conv_hb+(s*2+conv_tab[2560+n*8+3])*CONV_BS) : x;
      ) :
      t==11 ? sup_run(k,q,base,x,q[7],q[22],q[2],q[3],q[4]) :
      fx_type_run(q,t,base,x,pressure_mode);
    x=fx_lane_end(q,x,y);
  );
  x;
);
