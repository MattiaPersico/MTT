desc:MTT Breeze
// Version: 0.5.1 (per-engine/OUT chains; sliders 1-120 and effect path preserved)
// Physically informed aeroacoustic wind generator. Frequencies, bandwidths, harmonics and
// level laws follow Selfridge et al. (Aeolian tone, JAES 2018; cavity tone, DAFx-17) where
// they give them. Elastic wires and cavity feedback are self-oscillating documented models,
// not CFD. Provenance, assumptions and limits: docs/effects/mtt_wind_lab.md.

author:MTT
tags:generator synthesis wind physical-modeling
in_pin:none
out_pin:L
out_pin:R
out_pin:C
out_pin:LFE
out_pin:Ls / Lss
out_pin:Rs / Rss
out_pin:Lrs
out_pin:Rrs
out_pin:Ltf
out_pin:Rtf
out_pin:Ltr
out_pin:Rtr

options:maxmem=100663296

import wl_routes.jsfx-inc
import wl_conv.jsfx-inc
import wl_supp.jsfx-inc
import wl_fx.jsfx-inc
import wl_core.jsfx-inc
import wl_rack.jsfx-inc
import wl_array.jsfx-inc
import wl_models.jsfx-inc
// Breeze interface artwork (docs/effects/mtt_wind_lab/design/final/assets/png): image slots
// 0-15, each as light 1x, light 2x, dark 1x, dark 2x; REAPER loads PNG filename: entries
// relative to this file.
filename:0,breeze_bg_light.png
filename:1,breeze_bg_light_2x.png
filename:2,breeze_bg_dark.png
filename:3,breeze_bg_dark_2x.png
filename:4,breeze_wordmark_light.png
filename:5,breeze_wordmark_light_2x.png
filename:6,breeze_wordmark_dark.png
filename:7,breeze_wordmark_dark_2x.png
filename:8,breeze_windmark_light.png
filename:9,breeze_windmark_light_2x.png
filename:10,breeze_windmark_dark.png
filename:11,breeze_windmark_dark_2x.png
filename:12,breeze_icons_light.png
filename:13,breeze_icons_light_2x.png
filename:14,breeze_icons_dark.png
filename:15,breeze_icons_dark_2x.png
filename:16,breeze_wordmark_source.png

slider1:12<0,70,0.1>-Wind speed (m/s)
slider2:35<0,100,1>-Gust depth (%)
slider3:50<2,400,1>-Gust length scale (m)
slider4:40<0,100,1>-Turbulence (%)
slider5:20<0.5,200,0.1>-Obstacle diameter (mm)
slider6:45<0,100,1>-Obstacle spread (%)
slider7:0.35<0.005,2,0.001>-Cavity length (m)
slider8:0.2<0.005,2,0.001>-Cavity depth / neck (m)
slider9:0.15<0.005,2,0.001>-Cavity width (m)
slider10:0<0,100,1>-Cavity damping (%)
slider11:30<0,100,1>-Air level (%)
slider12:45<0,400,1>-Obstacle level (%)
slider13:40<0,100,1>-Cavity level (%)
slider14:100<0,100,1>-Width (%)
slider15:-12<-60,12,0.1>-Output (dB; -60 = mute)
slider16:0<0,5,1{All,Air only,Obstacles only,Cavity only,Ensemble only,Mic noise only}>-Listen
slider17:1<0,1,1{Muted,On}>-Generator
slider18:12345<1,65535,1>-Random seed
slider19:0<0,2,1{Rigid circular cylinder,Rigid square prism,Elastic wire (Aeolian harp)}>-Obstacle type
slider20:1<0.02,20,0.01>-Obstacle span (m)
slider21:0<0,75,1>-Obstacle yaw (deg)
slider22:110<20,600,0.1>-Wire pitch (Hz)
slider23:10<0,100,1>-Wire damping (%)
slider24:0<0,3,1{Compact sources (Selfridge/Howe),Feedback: rectangular cavity,Feedback: Helmholtz resonator,Feedback: edge tone}>-Cavity model
slider25:0<0,1,1{Selfridge/Howe sqrt(pi A/4),Equivalent radius 0.61 a}>-Cavity end correction
slider26:10<1,200,0.1>-Helmholtz volume (cube side, cm)
slider27:1<0,4,1{Legacy mute,Fence rods,Cable bundle,Pine needles,Custom}>-Ensemble
slider28:0<0,100,1>-Ensemble level (%)
slider29:0<0,100,1>-Mic wind noise (%)
slider30:2<0,2,1{None,Foam,Fur}>-Windscreen
slider31:180<-180,180,1>-Moving object angle (legacy, deg from the direction of travel)
slider32:2.5<0.5,200,0.1>-Distance to the wind (m)
slider33:20<-20,40,0.1>-Temperature (C)
slider34:0<0,1,1{Wind past fixed objects,Moving object (swoosh)}>-Motion
slider35:0<0,1,1{Off,On}>-Pen input (MTT Input Bridge)
slider36:30<1,70,0.1>-Pen range (m/s at full input)
slider37:0<0,1,1{Continue,Restart sequence}>-On transport start
// MTT Input Bridge protocol 1 transport (same contract as MTT Loon sliders 88-98). Live
// connection state, not sound parameters: the native extension finds these by their exact
// names and ranges. Only Request is written here, mirrored from slider 35.
slider38:1<0,1,1>-MTT Tablet Protocol
slider39:0<0,1,1>-MTT Tablet Request
slider40:0<0,10,1>-MTT Tablet Status
slider41:0<0,16777214,1>-MTT Tablet Frame
slider42:0.5<0,1,0.000001>-MTT Tablet X
slider43:0.5<0,1,0.000001>-MTT Tablet Y
slider44:0<0,1,0.000001>-MTT Tablet Pressure
slider45:0<0,1,1>-MTT Tablet Contact
slider46:0<0,1,1>-MTT Tablet Proximity
slider47:0<0,16777214,1>-MTT Tablet Producer Tick
slider48:0<0,16777214,1>-MTT Tablet Consumer Tick
// Pen response (0.2.1): what drives the speed, separate attack and release times (rest to
// full range and back) and their curves (61-62).
slider49:0<0,3,1{Gesture speed,Pressure,Height (Y),Position (X)}>-Pen drives
slider50:20<1,2000,1>-Pen attack (ms)
slider51:400<5,5000,1>-Pen release (ms)
slider52:0<0,1,1{Off,On}>-Pen X moves the wind
// Ensemble characteristics (0.2.1), used when Ensemble = Custom; the three types have built-in
// values (table ENS_P), which the interface copies here when one of them is edited.
slider53:15<0.3,100,0.01>-Ensemble element diameter (mm)
slider54:5<0,80,0.1>-Ensemble diameter spread (%)
slider55:24<1,100000,1>-Ensemble element count
slider56:1<0.005,50,0.001>-Ensemble element length (m)
slider57:5<0,60,0.1>-Ensemble local speed spread (%)
slider58:1<0.1,1,0.01>-Ensemble shelter (speed factor)
// Air bed tone (0.2.1): a gentle 2-pole low-pass (rising with the wind speed) and a low cut.
slider59:700<100,8000,1>-Air tone (Hz at 12 m/s)
slider60:40<20,400,1>-Air low cut (Hz)
// Pen response curves (0.2.1): + fast start, 0 straight, - slow start.
slider61:0<-100,100,1>-Pen attack curve (%)
slider62:50<-100,100,1>-Pen release curve (%)
// Gust events (0.2.1): occasional slow gusts on top of the continuous fluctuation.
slider63:0<0,30,0.1>-Gust events (per minute)
slider64:80<0,300,1>-Gust event strength (%)
// Sliders above 64 need a REAPER version with 256-slider JSFX support (as MTT Loon).
slider65:6<0.5,30,0.1>-Gust event duration (s)
// Gust proximity, microphone wind direction and ensemble width (0.2.1).
slider66:0<0,100,1>-Gust proximity (%)
slider67:0<-180,180,1>-Array rotation (deg on the map, clockwise from the top)
slider68:360<0,360,1>-Wind width (deg)
// Gust proximity character (0.2.1): centre of the push band and how fast it comes and goes.
slider69:32<15,100,0.1>-Gust proximity pitch (Hz)
slider70:50<0,100,1>-Gust proximity reactivity (%)
// Microphone array (0.2.1): one output per capsule.
slider71:1<0,6,1{Mono,Stereo,LCR,Quad,5.1,7.1,7.1.4}>-Microphone array
// Interface preferences (0.3.0, as MTT Loon's theme and lock sliders): not sound parameters,
// not interface undo steps, saved with the project.
slider72:0<0,1,1{Light,Dark}>-Interface theme
slider73:0<0,63,1>-Random wind locks (bit mask)
// Engine switches (0.3.1): a sound section on or off. Off silences its layer and skips its
// computation, like a level of 0; its settings are kept.
slider74:1<0,1,1{Off,On}>-Obstacles on
slider75:1<0,1,1{Off,On}>-Cavity on
slider76:1<0,1,1{Off,On}>-Ensemble on
slider77:1<0,1,1{Off,On}>-Air bed on
slider78:1<0,1,1{Off,On}>-Mic on
// Optional MTT Input Bridge trackpad capability and live source (0.3.1; exact names and
// ranges of MTT Loon's 246-247). Not sound parameters. With them the bridge can lend a Mac
// Force Touch trackpad: it sets Request (39) itself and Source to 1 while the trackpad plays.
slider79:1<0,1,1>-MTT Input Trackpad
slider80:0<0,1,1>-MTT Input Source
// The map (0.3.1): where the wind comes from on it (81: 0 = top, clockwise; interface frame
// only) and its width (82: the wind's arc lies on its rim, so the DSP places the sources
// with it). The map places the array at distance 32 from the arrows, on the side given by
// 31 (its angle from upstream seen from the arrows), and draws 67 (relative to the wind)
// turned by 81. Turning the wind keeps the array where it is (32, 31 and 67 follow); Max
// distance scales the map (32 scales with it, the directions stay).
slider81:0<-180,180,1>-Wind direction (deg on the map, clockwise from the top)
slider82:5<1,200,0.1>-Map max distance (m)
// Ensemble pitch follow (0.3.1): how much the group pitches follow the gusts (100 % = the
// physical f ~ U; 0 = held at the mean speed, the gusts then only move the level).
slider83:100<0,100,1>-Ensemble pitch follow (%)
// Level balance (0.3.1): flattens the level's swing with the Wind speed slider (Off: the full
// physical dynamics).
slider84:0<0,1,1{Off,On}>-Level balance
// Mic directivity (0.3.1): the stereo pair's pattern from cardioid (0) to a narrow beam (100 %:
// cardioid^4), power kept per direction, so only the separation between the channels grows.
slider85:0<0,100,1>-Mic directivity (%)


