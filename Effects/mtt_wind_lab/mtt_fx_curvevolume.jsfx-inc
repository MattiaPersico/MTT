// GENERATED by make sync-lib from lib/fx/mtt_fx_curvevolume.jsfx-inc. Edit that file, then run make sync-lib; never edit this copy.
// MTT shared FX library: Curve Volume (FX type 9). Needs mtt_fx_core. API card: lib/README.md.
// Multiplies the signal by a drawn periodic curve (Catmull-Rom through 64 points).
// A: rate 0.05-100 Hz, B: speed wobble (bends the rate by up to 2.5 octaves), C: curve wobble
// (slow timing noise and faster level noise relative to the curve; a silent curve stays silent).
// The wet amount is the depth.
// Curves: fx_curve + slot * 65 (64 gains 0..1, then the marker 1); the host chooses fx_curve.
// Lane state: q[8..10] smoothed noise, q[5] phase.
@init
// Drawn curve of a slot: 64 gain values over one cycle, then the marker (1).
// kind: 0 raised cosine, 1 triangle, 2 ramp up, 3 ramp down, 4 clipped sine, 5 random.
function fx_curve_preset(n,kind) local(cv,i,u,v) (
  cv=fx_curve+n*65; i=0;
  loop(64,
    u=i/64;
    v=kind==1 ? 1-abs(2*u-1) : kind==2 ? u : kind==3 ? 1-u :
      kind==4 ? .5+.5*max(-1,min(1,3*sin(2*$pi*u))) :
      kind==5 ? (i==0 ? rand(1) : cv[i-1]*.6+.4*rand(1)) :
      .5-.5*cos(2*$pi*u);
    cv[i]=max(0,min(1,v)); i+=1;
  );
  cv[64]=1;
);
// Periodic [1 2 1] / 4 smoothing of slot n's curve. slots: the number of curves in the bank
// (64 scratch values follow them).
function fx_curve_smooth(n,slots) local(cv,t,i) (
  cv=fx_curve+n*65; t=fx_curve+slots*65;
  i=0; loop(64, t[i]=.25*cv[(i+63)&63]+.5*cv[i]+.25*cv[(i+1)&63]; i+=1;);
  i=0; loop(64, cv[i]=t[i]; i+=1;);
);
function fx_curvevol_targets(q,r,a,b,c) (q[18]=.05*2000^a; q[19]=b; q[20]=c;);
// curve: the slot's 64 points. Lanes of one slot can share one modulation: the lane with
// lead = 1 advances the noise and the phase and, when mod is not 0, publishes them in
// mod[0..2]; the others (lead = 0) read them from mod. A lane on its own: mod = 0, lead = 1.
function fx_curvevol_run(q,x,curve,mod,lead) local(a,b,c,r,ph,w,u,ci,p0,p1,p2,p3,y) (
  a=q[2]; b=q[3]; c=q[4]; r=q[22];
  lead ? (
    q[8]+=q[27]*((rand(2)-1)*q[28]-q[8]);
    q[9]+=q[29]*((rand(2)-1)*q[30]-q[9]);
    q[10]+=q[27]*((rand(2)-1)*q[28]-q[10]);
    ph=q[5]+2*$pi*a*2^(b*max(-2.5,min(2.5,q[8])))/r;
    mod ? (mod[0]=ph; mod[1]=q[9]; mod[2]=q[10];);
    w=q[10];
  ) : (
    ph=mod[0]; q[9]=mod[1]; w=mod[2];
  );
  u=ph/(2*$pi)+c*.08*max(-2.5,min(2.5,w)); u-=floor(u);
  u*=64; ci=floor(u); u-=ci;
  p0=curve[(ci+63)&63]; p1=curve[ci&63]; p2=curve[(ci+1)&63]; p3=curve[(ci+2)&63];
  y=p1+.5*u*(p2-p0+u*(2*p0-5*p1+4*p2-p3+u*(3*(p1-p2)+p3-p0)));
  q[5]=ph;
  x*max(0,min(1,y*(1+c*.5*max(-2.5,min(2.5,q[9])))));
);
