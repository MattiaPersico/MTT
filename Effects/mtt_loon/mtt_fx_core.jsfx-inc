// GENERATED by make sync-lib from lib/fx/mtt_fx_core.jsfx-inc. Edit that file, then run make sync-lib; never edit this copy.
// MTT shared FX library: lane core. Used by MTT Loon and MTT Breeze.
// Source of truth: lib/fx/ in MTT_ReaperEffects. Effects import vendored copies made by
// `make sync-lib`; edit the lib/ file, never a copy. API card: lib/README.md.
//
// A rack lane is one mono audio path through one FX slot. The host effect owns the topology
// (how many lanes, their slot, rate and order, routing, stereo linking) and calls, per lane:
//   once per block:  fx_lane_targets(q,t,r,a,b,c,top)              (mtt_fx_types.jsfx-inc)
//   per sample:      fx_lane_begin(q) ? (y=<type run>; x=fx_lane_end(q,x,y););
//
// q    = fx_st + lane * 32: lane state, owned by the audio thread.
//   0 running type        1 smoothed wet          2-4 smoothed A, B, C
//   5 phase (radians)     6 write position        7 age: samples since the lane (re)started
//                                                   (0 = the type must clear its history)
//   8-15 per-type state   16 target type          17 target wet
//   18-20 A, B, C targets 21 smoothing coefficient 22 lane rate (Hz)
//   23-24 Group Delay coefficient targets          25-26 their smoothed values
//   27-30 Curve Volume wobble coefficients          31 per-type (Suppressor decimation)
// base = the lane's private arena: at least 131072 words; delay lines and tables live there.
//
// Slot configuration (fx_cfg + slot * 6): type, wet, A, B, C, enabled (all 0..1 but type).
// Types: 0 empty, 1 Ring Mod, 2 Flanger, 3 Chorus, 4 Delay, 5 Reverb, 6 Saturation,
// 7 legacy dispersion (migrated to 8), 8 Group Delay, 9 Curve Volume, 10 Convolver,
// 11 Resonance Suppressor. One file per type: mtt_fx_<name>.jsfx-inc.
//
// Import order (EEL2 functions can only call functions defined before them):
//   mtt_fx_core, the type files, mtt_fx_types, then the effect's own rack file.
@init
// Fractional delay-line read (linear interpolation), d samples back from pos; 0 until the line
// holds d + 1 samples. mask = line length - 1 (a power of two).
function fx_tap(base,pos,age,d,mask) local(ix,f) (
  d=max(1,min(mask-2,d)); ix=floor(d); f=d-ix;
  age>=ix+1 ? base[(pos-ix)&mask]*(1-f)+base[(pos-ix-1)&mask]*f : 0;
);
// Start of a lane's sample: fades the wet towards its target (through dry before a type
// change), swaps in the new type once the old one is silent (histories restart by age, not
// memset) and smooths A, B and C. Returns 1 when the lane must process this sample; otherwise
// clears the per-type state and returns 0.
function fx_lane_begin(q) local(t,w,sc) (
  t=q[0]; sc=q[21];
  w=q[16]!=t ? 0 : q[17];
  q[1]+=sc*(w-q[1]); abs(q[1]-w)<.000001 ? q[1]=w;
  q[16]!=t && q[1]==0 ? (
    q[0]=t=q[16]; q[5]=q[6]=q[7]=0;
    q[8]=q[9]=q[10]=q[11]=0;
    q[2]=q[18]; q[3]=q[19]; q[4]=q[20];
    q[25]=q[23]; q[26]=q[24];
  );
  // Keep the old algorithm's parameters while fading out for replacement.
  t==q[16] ? (q[2]+=sc*(q[18]-q[2]); q[3]+=sc*(q[19]-q[3]); q[4]+=sc*(q[20]-q[4]););
  t>0 && q[1]>0 ? 1 : (q[7]=0; q[8]=q[9]=q[10]=q[11]=0; 0);
);
// End of a lane's sample: wraps the phase, advances the write position and the age, and mixes
// the processed sample y into the input x by the smoothed wet. Returns the lane's output.
function fx_lane_end(q,x,y) local(ph) (
  ph=q[5]; ph>=2*$pi ? ph-=2*$pi;
  q[5]=ph; q[6]=(q[6]+1)&131071; q[7]=min(131072,q[7]+1);
  x+q[1]*(y-x);
);
