// GENERATED by make sync-lib from lib/fx/mtt_fx_reverb.jsfx-inc. Edit that file, then run make sync-lib; never edit this copy.
// MTT shared FX library: Reverb (FX type 5). Needs mtt_fx_core. API card: lib/README.md.
// Four damped feedback combs mixed in parallel (a small Schroeder-style room).
// A: size (comb delays scale 0.4-1.6), B: decay (feedback 0.1-0.9), C: damping, a one-pole
// low-pass from 300 Hz up to `top` Hz (the host's choice, see fx_lane_targets).
// Lane state: q[8..11] comb low-pass states; arena: four 32768-sample lines.
@init
function fx_reverb_targets(q,r,a,b,c,top) (
  q[18]=.4+1.2*a; q[19]=.1+b*.8;
  q[20]=1-exp(-2*$pi*min(r*.4,300*(top/300)^c)/r);
);
function fx_reverb_run(q,base,x) local(a,b,c,pos,age,r,y,j,d,z,wet) (
  a=q[2]; b=q[3]; c=q[4]; pos=q[6]; age=q[7]; r=q[22];
  y=0; j=0; loop(4,
    d=min(32765,(j==0?.0297:j==1?.0371:j==2?.0411:.0437)*a*r);
    z=fx_tap(base+j*32768,pos&32767,age,d,32767);
    q[8+j]+=c*(z-q[8+j]);
    wet=x*.35+b*q[8+j]; base[j*32768+(pos&32767)]=max(-32,min(32,wet));
    y+=z*.5; j+=1;
  );
  y;
);
