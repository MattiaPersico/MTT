// MTT shared FX library: Ring Mod (FX type 1). Needs mtt_fx_core. API card: lib/README.md.
// A: carrier frequency 1 Hz - 2 kHz (at most a fifth of the lane rate). B and C unused.
// Lane state: q[5] carrier phase.
@init
function fx_ringmod_targets(q,r,a,b,c) (q[18]=min(r*.2,1*2000^a); q[19]=b; q[20]=c;);
// unipolar: 1 multiplies by 0..1 instead of -1..1 (Loon uses it on the air pressure).
function fx_ringmod_run(q,x,unipolar) local(ph,y) (
  ph=q[5];
  y=x*(unipolar ? .5+.5*sin(ph) : sin(ph));
  q[5]=ph+2*$pi*q[2]/q[22];
  y;
);
