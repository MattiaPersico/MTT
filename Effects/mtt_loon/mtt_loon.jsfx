// Custom rack controls edit saved state, with one local undo step per gesture.
function fx_name(t) (t==1?"Ring Mod":t==2?"Flanger":t==3?"Chorus":t==4?"Delay":t==5?"Reverb":t==6?"Saturation":t==8?"Disperser":"+ Add effect");
function fx_point_name(n) (
  n==0?"Air pressure":n==1?"Glottal flow":n==2?"Tract 1 > 2":n==3?"Tract 2 > 3":
  n==4?"Tract 3 > 4":n==5?"Tract 4 > 5":n==6?"Return to folds":
  n==7?"Cavity 1 pickup":n==8?"Cavity 2 pickup":n==9?"Cavity 3 pickup":
  n==10?"Cavity 4 pickup":n==11?"Cavity 5 pickup":n==12?"Mouth pickup":"Stereo output";
);
// Four main racks: Source(1), Tract(2), Feedback(6), Output(13).
function fx_is_main(p) (p==1||p==2||p==6||p==13;);
function fx_main_point(i) (i==0?1:i==1?2:i==2?6:13;);
function fx_rack_name(i) (i==0?"Source":i==1?"Tract":i==2?"Feedback":"Output");
function fx_rack_name_pt(p) (p==1?"Source":p==2?"Tract":p==6?"Feedback":"Output");
// Legacy dropdown: 10 non-main points in order 0,3,4,5,7,8,9,10,11,12.
function fx_legacy_pt(i) (i==0?0:i==1?3:i==2?4:i==3?5:i==4?7:i==5?8:i==6?9:i==7?10:i==8?11:12;);
function fx_default(t,f) (t==8 ? (f==1?1:f==2?log(20)/log(800):f==3?.5:f==4?log(5)/log(64):1) : f==1?.35:f==2?.4:f==3?.35:f==4?(t==6?1:.5):1;);
function fx_swap(a,b) local(i,v) (
  push_undo(); i=0; loop(6,v=fx_cfg[a+i]; fx_cfg[a+i]=fx_cfg[b+i]; fx_cfg[b+i]=v; i+=1;); fx_touch();
);
// Move the complete configuration to a free destination slot as one undo step.
function fx_move(source,point) local(j,dest) (
  dest=-1;
  source>=0 && source<42 && point>=0 && point<14 && floor(source/3)!=point && fx_cfg[source*6]>0 ? (
    j=0; loop(3, dest<0 && fx_cfg[(point*3+j)*6]==0 ? dest=point*3+j; j+=1;);
    dest>=0 ? (
      push_undo(); memcpy(fx_cfg+dest*6,fx_cfg+source*6,6);
      memset(fx_cfg+source*6,0,6); fx_touch();
    );
  );
  dest+1;
);
// Move menu: four main racks first, then non-main points with occupied slots.
function fx_pt_occ(p) local(j,n) (
  n=0; j=0; loop(3, fx_cfg[(p*3+j)*6]>0 ? n=1 : 0; j+=1;);
  n;
);
function fx_move_menu(source,x,y) local(k,j,used,r,n,sel) (
  strcpy(#fx_move_menu,""); n=0;
  // Main points first.
  k=0; loop(14,
    fx_is_main(k) ? (
      n>0 ? strcat(#fx_move_menu,"|");
      used=0; j=0; loop(3,fx_cfg[(k*3+j)*6]>0 ? used+=1; j+=1;);
      k==floor(source/3) || used==3 ? strcat(#fx_move_menu,"#");
      strcat(#fx_move_menu,fx_rack_name_pt(k));
      strcat(#fx_move_menu,k==floor(source/3)?"  (current)":used==3?"  (full)":"");
      n+=1; k+=1;
    ) : k+=1;
  );
  // Then non-main points with occupied slots.
  k=0; loop(14,
    !fx_is_main(k) && fx_pt_occ(k) ? (
      n>0 ? strcat(#fx_move_menu,"|");
      used=0; j=0; loop(3,fx_cfg[(k*3+j)*6]>0 ? used+=1; j+=1;);
      k==floor(source/3) || used==3 ? strcat(#fx_move_menu,"#");
      strcat(#fx_move_menu,fx_point_name(k));
      strcat(#fx_move_menu,k==floor(source/3)?"  (current)":used==3?"  (full)":"");
      n+=1; k+=1;
    ) : k+=1;
  );
  gfx_x=x*g_s; gfx_y=y*g_s; r=gfx_showmenu(#fx_move_menu);
  // Map menu index to point: main items are positions 0-3, legacy start at 4.
  sel=0;
  r>0 ? (
    r-1<4 ? sel=fx_main_point(r-1)+1 : (
      k=0; j=0;
      loop(14,
        sel==0 && !fx_is_main(k) && fx_pt_occ(k) ? (
          j==r-5 ? sel=k+1 : j+=1
        ) : 0;
        k+=1;
      );
    );
  );
  sel>0 && fx_move(source,sel-1)>0 ? sel : 0;
);
function fx_control(idx,x,y,w,str,t,f) local(v,ov,rate,def) (
  v=fx_cfg[idx]; ov=hit(x,y,w,57);
  ov ? col_text() : col_dim(); label(x,y,str);
  col_line(); grect(x,y+18,w,3); col_warm(); grect(x,y+18,w*v,3);
  rate=g_fx_point==13 ? srate : srate*max(1,ceil(192000/srate));
  f==1 ? sprintf(#fx_val,"%.0f %%",v*100) :
  f==2 ? (
    t==8 ? sprintf(#fx_val,"%.0f Hz",min(rate*.4,20*800^v)) :
    t==1 ? sprintf(#fx_val,"%.1f Hz",min(rate*.2,2000^v)) :
    t==2 ? sprintf(#fx_val,"%.2f Hz",.02*200^v) :
    t==3 ? sprintf(#fx_val,"%.2f Hz",.05*60^v) :
    t==4 ? sprintf(#fx_val,"%.0f ms",min(131068/rate,.001*500^v)*1000) :
    t==5 ? sprintf(#fx_val,"%.2f x",.4+1.2*v) : sprintf(#fx_val,"%.1f dB",36*v);
  ) : f==3 ? (
    t==8 ? sprintf(#fx_val,"%.1f",128*v) :
    t==2 ? sprintf(#fx_val,"%.1f ms",v*4) : t==3 ? sprintf(#fx_val,"%.1f ms",1+v*9) :
    t==4 ? sprintf(#fx_val,"%.0f %%",v*85) : t==5 ? sprintf(#fx_val,"%.0f %%",10+v*80) :
    sprintf(#fx_val,"%+.2f",v-.5);
  ) : (
    t==8 ? sprintf(#fx_val,"Q %.2f",.5*64^v) :
    t==2 || t==3 ? sprintf(#fx_val,"%.0f %%",v*(t==2?85:50)) :
    t==4 || t==5 ? sprintf(#fx_val,"%.0f Hz",300*(16000/300)^v) : sprintf(#fx_val,"%.1f dB",-18+18*v);
  );
  col_dim(); label(x,y+29,#fx_val);
  press && ov ? (
    push_undo();
    time_precise()-g_fx_last_t<.3 && g_fx_last_id==idx ? (
      fx_cfg[idx]=fx_default(t,f); g_fx_drag=0; g_fx_last_id=-1; fx_touch();
    ) : (
      g_fx_drag=idx+1; g_fx_start_x=g_mx; g_fx_start_v=v;
      g_fx_last_id=idx; g_fx_last_t=time_precise();
    );
  );
  down && g_fx_drag==idx+1 ? (
    fx_cfg[idx]=max(0,min(1,g_fx_start_v+(g_mx-g_fx_start_x)/w*((mouse_cap&8)?.1:1)));
    fx_cfg[idx]!=v ? fx_touch();
  );
);
