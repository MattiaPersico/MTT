    bho+=bhp_c*(b_odd-bho); b_odd-=bho; bhe+=bhp_c*(b_even-bhe); b_even-=bhe;
    radiated+=b_odd+b_even;
    // Side signal: branch pan difference plus a little body-versus-mouth difference
    // (weights keep L/R correlation mostly positive at width .7).
    side=.7*(b_odd-b_even)+.3*(bv2-mouth_out);
  );
  aa1+=aa_c*(radiated-aa1); aa2+=aa_c*(aa1-aa2);
  aa3+=aa_c*(aa2-aa3); aa4+=aa_c*(aa3-aa4);
  sa1+=aa_c*(side-sa1); sa2+=aa_c*(sa1-sa2);
  sa3+=aa_c*(sa2-sa3); sa4+=aa_c*(sa3-sa4);
  pos=(pos+1)&8191; bpos=(bpos+1)&32767;
);
snap_on ? (smooth=sm_keep; gesture_c=gc_keep;);
// Radiation load as a shelf: rises like a derivative above ~700 Hz, flattens above ~5 kHz.
rad_y=aa4-rad_a*rad_prev+rad_b*rad_y; rad_prev=aa4;
rad_in=aa4+slider40*(rad_y-aa4);
dc=rad_in-dc_in+dc_c*dc_out; dc_in=rad_in; dc_out=dc;
// Side channel through the same radiation load and DC blocker.
srad_y=sa4-rad_a*srad_prev+rad_b*srad_y; srad_prev=sa4;
srad_in=sa4+slider40*(srad_y-sa4);
dcs=srad_in-dcs_in+dc_c*dcs_out; dcs_in=srad_in; dcs_out=dcs;
// Emergency reset is diagnostic, not the regular source nonlinearity.
max(max(abs(v1.xl1),abs(v1.xl2)),max(abs(v1.xr1),abs(v1.xr2)))>3 ||
  max(max(abs(v2.xl1),abs(v2.xl2)),max(abs(v2.xr1),abs(v2.xr2)))>3 || abs(outgoing)>128 || dc!=dc ? (
  fault_p=outgoing; faults+=1; reset_sound(); dc=0;
);
dcs!=dcs ? dcs=dcs_in=dcs_out=srad_y=srad_prev=0;
// Stereo: L = M + w*S, R = M - w*S (identical channels at width 0).
rawl=(dc+pv[62]*dcs)*gain*gate_env*2; rawr=(dc-pv[62]*dcs)*gain*gate_env*2;
// Output inserts follow the gate, before master gain and dynamics.
// Tails survive note release; Output still controls the entire sound.
fx_on[13] ? (
  rawl=fx_chain(13,(dc+pv[62]*dcs)*gate_env*2,0)*gain;
  rawr=fx_chain(13,(dc-pv[62]*dcs)*gate_env*2,1)*gain;
);
// Linked feed-forward compressor (like the Comp stage after each mixer). Amount 0 = bypass.
slider63>0 ? (
  cin=max(abs(rawl),abs(rawr));
  comp_env+=(cin>comp_env?comp_att:comp_rel)*(cin-comp_env);
  // Threshold falls and ratio rises with the amount; makeup leaves a level of .6 unchanged,
  // so quieter passages come up and loud ones go down.
  comp_thr=.6*10^(-slider63*1.5); comp_e=1/(1+5*slider63)-1;
  comp_g=(max(comp_env,comp_thr)/.6)^comp_e;
  rawl*=comp_g; rawr*=comp_g;
);
spl0=rawl/sqrt(1+rawl*rawl); spl1=rawr/sqrt(1+rawr*rawr);
peak=max(max(abs(spl0),abs(spl1)),peak*.9997);
scope_a[spos]=glottal_area; scope_o[spos]=(spl0+spl1)*.5; spos=(spos+1)&2047;
ga_lo=min(ga_lo,glottal_area); ga_hi=max(ga_hi,glottal_area); ga_sum+=glottal_area; ga_n+=1;

@serialize
// The recorded gesture is stored with the project (not the loop on/off state).
// A marker guards against states saved without gesture data. 4012: (t, x, y, z) points;
// 4014 (0.26) adds the performance links; 4015 (0.27) appends the FX rack;
// 4011 (up to 0.19): (t, x, y) points, loaded with z = 1 (neutral air drive).
file_avail(0)<0 ? (
  ser_magic=4015; file_var(0,ser_magic); file_var(0,rec_n); file_var(0,rec_len);
  rec_n>0 ? file_mem(0,recbuf,rec_n*REC_W);
  // The links: count, then (id, axis, from, to, curve) for each linked parameter.
  ser_c=0; ser_i=1;
  loop(249, lk_a[ser_i]>0 ? (
    lk_ser[ser_c*5]=ser_i; lk_ser[ser_c*5+1]=lk_a[ser_i]-1; lk_ser[ser_c*5+2]=lk_lo[ser_i];
    lk_ser[ser_c*5+3]=lk_hi[ser_i]; lk_ser[ser_c*5+4]=lk_c[ser_i]; ser_c+=1;
  ); ser_i+=1;);
  file_var(0,ser_c); ser_c>0 ? file_mem(0,lk_ser,ser_c*5);
  file_mem(0,fx_cfg,252);
) : (
  // A saved tablet request is never restored (live connection state); in a running
  // instance a preset keeps the request, the theme and the preview switch as they are.
  pref_ready ? (
    slider72=pref_theme; slider64=pref_prev; slider89=pref_req;
    sliderchange(slider72); sliderchange(slider64);
  ) : slider89=0;
  tb_seen=0; tb_last_seen=-1; tb_note=1;
  ser_magic=0; file_var(0,ser_magic);
  // 4014 (0.26): 4012 gesture data, then the links. 4013 (0.25): 4012 data, the links in
  // sliders 162-241. 4012/4011: the old pad mappings, routes and pen maps become links.
  ser_magic==4012 || ser_magic==4011 ? migrate_links();
  ser_magic==4013 ? migrate_slots();
  ser_magic>=4011 && ser_magic<=4015 ? (
    file_var(0,rec_n); file_var(0,rec_len);
    rec_n=max(0,min(REC_MAX,floor(rec_n)));
    ser_magic!=4011 ? (rec_n>0 ? file_mem(0,recbuf,rec_n*REC_W);) : (
      rec_n>0 ? file_mem(0,recbuf,rec_n*3);
      // Spread the triplets to quadruplets in place, last point first (never overlaps).
      ser_i=rec_n-1;
      while(ser_i>=0) (
        recbuf[ser_i*4+3]=1; recbuf[ser_i*4+2]=recbuf[ser_i*3+2];
        recbuf[ser_i*4+1]=recbuf[ser_i*3+1]; recbuf[ser_i*4]=recbuf[ser_i*3];
        ser_i-=1;
      );
    );
    rec_n<2 ? (rec_n=0; rec_len=0; take_active=0; rec_pen=0;) : take_store();
    loop_play=0;
  );
  ser_magic>=4014 && ser_magic<=4015 ? (
    ser_c=0; file_var(0,ser_c); ser_c=max(0,min(249,floor(ser_c)));
    lk_clear(); ser_c>0 ? file_mem(0,lk_ser,ser_c*5);
    ser_i=0; loop(ser_c, lk_put(floor(lk_ser[ser_i*5]),max(0,min(2,floor(lk_ser[ser_i*5+1]+.5))),lk_ser[ser_i*5+2],lk_ser[ser_i*5+3],lk_ser[ser_i*5+4]); ser_i+=1;);
  );
  memset(fx_cfg,0,252);
  ser_magic==4015 ? file_mem(0,fx_cfg,252);
  fx_validate(); memset(fx_st,0,45*32);
  fx_ready=1; lk_ready=1;
);

@gfx 902 693
// THREADING: REAPER runs @gfx on another thread than @block/@sample. Never use a
// global temporary here that the audio code also uses (loop counters above all):
// gfx-only temporaries are prefixed g or are function locals. The only globals
// written from here are the control flags gui_*, hold_on, loop_*, play_i, panic,
// last_mode, and slider89 (the pen request; tests/coupled.cpp checks this list).
// ---------- helpers ----------
// Drawing is written in 820x630 points; g_s = pixels per point (window size and Retina).
// The layout is 820 x 630 points; it scales with the window (and the Retina factor).
g_s=gfx_w>0 && gfx_h>0 ? max(.5,min(gfx_w/820,gfx_h/630)) : max(1,gfx_ext_retina); g_mx=mouse_x/g_s; g_my=mouse_y/g_s; g_dark=slider72>=.5;
// Use physical-pixel spacing for low-density concentric strokes.
g_arc_step=gfx_ext_retina<1.5 ? 1/g_s : .6;
g_arrow_step=gfx_ext_retina<1.5 ? 1/g_s : .5;
// Snap edges, not widths: adjacent rectangles then share the same pixel boundary.
// Curves and diagonal strokes keep fractional coordinates for antialiasing.
function gpixel(v) (floor(v+.5););
function grect(x,y,w,h) local(px,py) (
  px=gpixel(x*g_s); py=gpixel(y*g_s);
  gfx_rect(px,py,gpixel((x+w)*g_s)-px,gpixel((y+h)*g_s)-py);
);
function grectf(x,y,w,h,f) local(px,py) (
  px=gpixel(x*g_s); py=gpixel(y*g_s);
  gfx_rect(px,py,gpixel((x+w)*g_s)-px,gpixel((y+h)*g_s)-py,f);
);
function glineaa(x1,y1,x2,y2,aa) (
  x1==x2 || y1==y2 ? gfx_line(gpixel(x1*g_s),gpixel(y1*g_s),gpixel(x2*g_s),gpixel(y2*g_s),0) :
  gfx_line(x1*g_s,y1*g_s,x2*g_s,y2*g_s,aa);
);
function gline(x1,y1,x2,y2) (glineaa(x1,y1,x2,y2,1););
function glineto(x,y) (gfx_lineto(x*g_s,y*g_s,1););
function gcircle(x,y,r,f) (gfx_circle(x*g_s,y*g_s,r*g_s,f,1););
function at(x,y) (gfx_x=gpixel(x*g_s); gfx_y=gpixel(y*g_s););
function gtext(str) (gfx_x=gpixel(gfx_x); gfx_y=gpixel(gfx_y); gfx_drawstr(str););
// Keep the typeface; small labels get at least 11 physical pixels at low density.
function gfont(slot,size) (
  gfx_setfont(slot,"American Typewriter",max(gfx_ext_retina<1.5 ? 11 : 1,gpixel(size*g_s)));
);
// Sliders 1-64 by bit mask; above 64 by passing the slider variable (REAPER 6.74+).
function setparam(id,v) (slider(id)=v; id<=64 ? slider_automate(2^(id-1)) : slider_automate(slider(id)););
function hit(x,y,w,h) (g_mx>=x && g_mx<x+w && g_my>=y && g_my<y+h;);
function label(x,y,str) (gfx_x=x*g_s;gfx_y=y*g_s;gtext(str););
function rlabel(x,y,str) local(w,h) (gfx_measurestr(str,w,h);gfx_x=x*g_s-w;gfx_y=y*g_s;gtext(str););
// Palette after the common loon: paper, ink, grey plumage, the red eye for what is live.
// Light (day): ink on paper. Dark (night lake): paper on ink. g_dark follows slider 72.
function col_bg() (g_dark ? gfx_set(.140,.145,.155,1) : gfx_set(.830,.826,.812,1););
function col_panel() (g_dark ? gfx_set(.180,.186,.198,1) : gfx_set(.790,.786,.772,1););
function col_line() (g_dark ? gfx_set(.285,.292,.307,1) : gfx_set(.700,.695,.680,1););
function col_text() (g_dark ? gfx_set(.880,.872,.845,1) : gfx_set(.130,.130,.140,1););
function col_dim() (g_dark ? gfx_set(.610,.603,.582,1) : gfx_set(.380,.370,.355,1););
function col_acc() (g_dark ? gfx_set(.850,.842,.815,1) : gfx_set(.160,.160,.170,1););
function col_warm() (g_dark ? gfx_set(.900,.360,.360,1) : gfx_set(.660,.140,.160,1););
function col_mark() (g_dark ? gfx_set(.470,.475,.480,1) : gfx_set(.520,.505,.480,1););
function col_hover() (g_dark ? gfx_set(.220,.227,.242,1) : gfx_set(.765,.760,.745,1););
function col_grid() (g_dark ? gfx_set(.215,.222,.237,1) : gfx_set(.755,.750,.735,1););
// Ink and red with an alpha (ink is the foreground: dark by day, light at night).
function col_ink(a) (g_dark ? gfx_set(.850,.842,.815,a) : gfx_set(.160,.160,.170,a););
function col_red(a) (g_dark ? gfx_set(.900,.360,.360,a) : gfx_set(.660,.140,.160,a););
function col_veil(a) (g_dark ? gfx_set(.140,.145,.155,a) : gfx_set(.830,.826,.812,a););
// Header control without a box: dim at rest, lit on hover, red while pressed.
// align 0 = left, 1 = centred; on draws a filled dot before the text (toggle state).
function tbutton(x,y,w,h,str,align,on,enabled) local(tw,th,over,tx) (
  over=hit(x,y,w,h);
  !enabled ? col_mark() : over && down ? col_warm() : over ? col_text() : col_dim();
  gfx_measurestr(str,tw,th);
  on>=0 ? (on ? gcircle(x+5,y+h/2-1,3.5,1) : gcircle(x+5,y+h/2-1,3.5,0); tx=x+14;) : tx=x;
  gfx_x=align ? x*g_s+(w*g_s-tw)/2 : tx*g_s; gfx_y=y*g_s+(h*g_s-th)/2; gtext(str);
  press && over && enabled;
);
// Circular arrow (undo when m = 1, redo when m = -1, mirrored), at the centre of a box.
function arrowbutton(x,y,w,h,m,enabled) local(over,cx,cy,r,a,k,ex,ey,dx,dy,nx,ny) (
  over=hit(x,y,w,h); cx=x+w/2; cy=y+h/2; r=5.5;
  !enabled ? col_mark() : over && down ? col_warm() : over ? col_text() : col_dim();
  // Arc from just right of the top, round the right and bottom, to the upper left.
  k=0; loop(3,
    a=-.15*$pi; gfx_x=(cx+m*(r-k*g_arrow_step)*sin(a))*g_s; gfx_y=(cy-(r-k*g_arrow_step)*cos(a))*g_s;
    loop(40, a+=1.4*$pi/40; gfx_lineto((cx+m*(r-k*g_arrow_step)*sin(a))*g_s,(cy-(r-k*g_arrow_step)*cos(a))*g_s,1););
    k+=1;
  );
  // Head at the start, pointing back along the arc (anticlockwise for undo).
  a=-.15*$pi; ex=cx+m*(r-g_arrow_step)*sin(a); ey=cy-(r-g_arrow_step)*cos(a);
  dx=-m*cos(a); dy=-sin(a); nx=m*sin(a); ny=-cos(a);
  gfx_triangle((ex+dx*3.4)*g_s,(ey+dy*3.4)*g_s,(ex+nx*3-dx*.5)*g_s,(ey+ny*3-dy*.5)*g_s,(ex-nx*3-dx*.5)*g_s,(ey-ny*3-dy*.5)*g_s);
  press && over && enabled;
);
function button(x,y,w,h,str,on) local(tw,th) (
  on ? col_acc() : hit(x,y,w,h) ? col_hover() : col_panel();
  grect(x,y,w,h);
  on ? col_bg() : col_text();
  gfx_measurestr(str,tw,th);gfx_x=x*g_s+(w*g_s-tw)/2;gfx_y=y*g_s+(h*g_s-th)/2;gtext(str);
  press && hit(x,y,w,h);
);
// Toggle drawn like Parameters Preview: a dot (filled = on) and its label, to the right
// of the dot or, with left set, to its left. x is the dot's left edge. True on a click.
function checkbox(x,y,str,on,left) local(tw,th,over,cy) (
  gfx_measurestr(str,tw,th); tw/=g_s; th/=g_s; cy=y-1+th*.5-1;
  over=left ? hit(x-6-tw-2,y-3,tw+18,18) : hit(x-2,y-3,tw+18,18);
  // The dot is the red "live" mark when on; the label keeps the hover/ink colours.
  on ? col_warm() : over ? col_text() : col_dim();
  gcircle(x+3.5,cy,3.5,on);
  over && down ? col_warm() : over||on ? col_text() : col_dim();
  left ? rlabel(x-6,y-1,str) : label(x+14,y-1,str);
  press && over;
);
// Pen (tablet) button: a pen drawn without a box, red while the tablet is on. True on a click.
// Pencil stroke: one pixel at 1x; on Retina a second, half-point offset pass gives it the
// weight of the undo arrows.
function pen_l(x1,y1,x2,y2) (glineaa(x1,y1,x2,y2,1); g_s>=2 ? glineaa(x1+.4,y1+.4,x2+.4,y2+.4,1););
function penbutton(x,y,on) local(over,tx,ty,dx,dy,nx,ny,ax,ay,bx,by,cx,cy) (
  over=hit(x-2,y-2,22,22);
  over && down ? col_warm() : on ? col_warm() : over ? col_text() : col_dim();
  // A plain pencil at 45 degrees: sharpened tip at the lower left, a straight barrel, a
  // band near the flat end. Outline only, like the undo arrows.
  tx=x+2.5; ty=y+16.5; dx=.7071; dy=-.7071; nx=.7071*1.9; ny=.7071*1.9;
  ax=tx+dx*5; ay=ty+dy*5; bx=tx+dx*19; by=ty+dy*19; cx=tx+dx*16; cy=ty+dy*16;
  pen_l(ax+nx,ay+ny,bx+nx,by+ny);pen_l(ax-nx,ay-ny,bx-nx,by-ny);
  pen_l(bx+nx,by+ny,bx-nx,by-ny);pen_l(cx+nx,cy+ny,cx-nx,cy-ny);
  pen_l(ax+nx,ay+ny,ax-nx,ay-ny);
  pen_l(ax+nx,ay+ny,tx,ty);pen_l(ax-nx,ay-ny,tx,ty);
  gfx_triangle((tx)*g_s,(ty)*g_s,(tx+dx*2+nx*.8)*g_s,(ty+dy*2+ny*.8)*g_s,(tx+dx*2-nx*.8)*g_s,(ty+dy*2-ny*.8)*g_s);
  press && over;
);
// Transport icon (kind 0 play, 1 pause, 2 stop) in an 18x18 box, no outline: dim at rest,
// lit on hover, red while pressed or while its state is on. True on a click.
function ticon(x,y,kind,on,enabled) local(over) (
  over=hit(x,y,20,18);
  !enabled ? col_mark() : over && down ? col_warm() : on ? col_warm() : over ? col_text() : col_dim();
  kind==0 ? gfx_triangle((x+6)*g_s,(y+3.5)*g_s,(x+6)*g_s,(y+14.5)*g_s,(x+15)*g_s,(y+9)*g_s) :
  kind==1 ? (grect(x+5.5,y+4,3.5,10); grect(x+11,y+4,3.5,10);) :
  grect(x+5.5,y+4.5,9,9);
  press && over && enabled;
);
// Slider control: label, value with unit, bar. Click/drag sets, double-click resets.
// Undo/redo: snapshots of parameters 5-71 (performance sliders 1-4 and the preview switch
// excluded) plus the recorded take (slot 1): a new take is an undo step too.
// Every link edit bumps slider 243, so REAPER marks the project changed (the links themselves
// are saved by @serialize).
function fx_touch() (setparam(244,slider244>=9999 ? 0 : slider244+1););
function lk_touch() (setparam(243,slider243>=9999 ? 0 : slider243+1););
function snap_store(buf,k) local(j,o) (
  o=k*UNDO_S; j=5; loop(238, buf[o+j]=slider(j); j+=1;);
  memcpy(buf+o+1280,fx_cfg,252);
  buf[o+1]=g_take;
  // A previewed control is stored with the value it had before the preview.
  g_prev_id>0 ? buf[o+g_prev_id]=g_prev_orig;
  j=0; loop(250, buf[o+256+j*4]=lk_a[j]; buf[o+257+j*4]=lk_lo[j]; buf[o+258+j*4]=lk_hi[j]; buf[o+259+j*4]=lk_c[j]; j+=1;);
);
// Slider 64 (hover preview switch) is a preference, not an undo step.
function snap_apply(buf,k) local(j,o,d) (
  o=k*UNDO_S;
  j=5; loop(238, j!=64 && j!=72 && (j<88 || j>98) && (j<162 || j>241) && slider(j)!=buf[o+j] ? setparam(j,buf[o+j]); j+=1;);
  d=0; j=0; loop(250,
    lk_a[j]!=buf[o+256+j*4] || lk_lo[j]!=buf[o+257+j*4] || lk_hi[j]!=buf[o+258+j*4] || lk_c[j]!=buf[o+259+j*4] ? (
      lk_a[j]=buf[o+256+j*4]; lk_lo[j]=buf[o+257+j*4]; lk_hi[j]=buf[o+258+j*4]; lk_c[j]=buf[o+259+j*4]; d=1;);
    j+=1;);
  d ? lk_touch();
  memcpy(fx_cfg,buf+o+1280,252); fx_validate(); fx_touch();
  // A different take: ask the audio thread to bring it back.
  buf[o+1]!=g_take ? (g_take=buf[o+1]; take_req=g_take+1;);
);
function push_undo() (
  undo_n>=100 ? (memcpy(undo_buf,undo_buf+UNDO_S,99*UNDO_S); undo_n=99;);
  snap_store(undo_buf,undo_n); undo_n+=1; redo_n=0;
);
function preview_end() (
  g_prev_id>0 ? (slider(g_prev_id)=g_prev_orig; g_prev_id=0;);
);
function do_undo() (
  preview_end();
  undo_n>0 ? (
    redo_n>=100 ? (memcpy(redo_buf,redo_buf+UNDO_S,99*UNDO_S); redo_n=99;);
    snap_store(redo_buf,redo_n); redo_n+=1; undo_n-=1; snap_apply(undo_buf,undo_n);
  );
);
function do_redo() (
  preview_end();
  redo_n>0 ? (
    snap_store(undo_buf,undo_n); undo_n+=1; redo_n-=1; snap_apply(redo_buf,redo_n);
  );
);
// Output, Compression and the loop's speed and wait never preview (level jumps, timing).
// Links (gfx side): lk_a[id] > 0 when a parameter is linked (one link per parameter, no limit).
function linkable(id) (id>4 && id!=49 && id!=50 && id!=64 && id!=72 && id!=73 && id!=99 && id<162 && thi[id]!=tlo[id];);
// Link a parameter to an axis (0 X, 1 Y, 2 Z): a new link initially spans the
// target's full travel; its offsets stay anchored to the fader when it moves.
// An existing link keeps its range and curve.
function lk_axis(id,ax) local(u) (
  g_prev_id==id ? preview_end();
  lk_a[id] ? lk_a[id]=ax+1 : (
    u=f_v2u(slider(id),tlo[id],thi[id],tlg[id]);
    lk_put(id,ax,-u,1-u,0);
  );
  lk_touch();
);
// Set a whole link (the dice).
function lk_set(id,ax,lo,hi) (lk_put(id,ax,lo,hi,0); lk_touch(););
function lk_val(id,which,v) (
  which==2 ? lk_lo[id]=max(-1,min(1,v)) : which==3 ? lk_hi[id]=max(-1,min(1,v)) : lk_c[id]=max(-1,min(1,v)); lk_touch();
);
function lk_remove(id) (lk_a[id]=0; lk_touch(););
// Right-click on a fader or knob: link to X, Y or Z, curve, remove (one undo step).
function link_menu(id) local(k,ax,c,r) (
  k=lk_a[id]>0; ax=k ? lk_a[id]-1 : -1; c=k ? lk_c[id] : 0;
  strcpy(#lm,"");
  strcat(#lm,ax==0 ? "!Link to X" : "Link to X"); strcat(#lm,ax==1 ? "|!Link to Y" : "|Link to Y");
