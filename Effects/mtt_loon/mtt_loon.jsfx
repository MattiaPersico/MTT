press && g_th_hit ? setparam(72,g_dark?0:1);
g_dice_hover=0;
// Parameters preview on/off.
tbutton(400,47,150,18,"Parameters Preview",0,slider64>=.5,1) ? (preview_end(); setparam(64,slider64>=.5?0:1););
