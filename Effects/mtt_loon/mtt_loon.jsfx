  col_text(); sprintf(#kval,fmt,id>=157 && id<=161 ? abs(slider(id)) : slider(id)); gfx_measurestr(#kval,tw,th); gfx_x=cx*g_s-tw/2; gfx_y=(cy+r+(g_knob_compact?1:16))*g_s; gtext(#kval);
