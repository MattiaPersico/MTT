slider243:0<0,9999,1>-Links edit counter

slider244:0<0,9999,1>-FX edit counter

@init
// HiDPI drawing (see @gfx): REAPER then reports the pixel scale in gfx_ext_retina.
gfx_ext_retina=1;
ext_noinit=0;
slider_show(-1,0);
notes=0; velocities=128; held=256;
ar=512; wr=528; wl=544; lpr=560; lpl=576; br=592; blp=608; btap=640;
ratios=624; ratios[0]=0.37; ratios[1]=0.61; ratios[2]=1; ratios[3]=1.37; ratios[4]=1.91;
queue=1024; rings=16384; branches=rings+81920;
scope_a=300000; scope_o=302048; defs=304100;
// Recorded pad gesture: (time s, x, y, z) points, REC_W values each; take = buffer being
// recorded. z = pen pressure (air drive multiplier); 1 for mouse takes and old (4011) states.
recbuf=310000; takebuf=1800000; REC_MAX=20000; REC_W=4;
// Undo snapshots: UNDO_S values per step, 100 steps each: sliders 5-242 at 0-255 (64 and 72 are
// preferences, 88-98 the tablet transport, 162-241 legacy), links at 256-1255,
// and FX at 1280-1531.
UNDO_S=1536; undo_buf=1900000; redo_buf=2060000;
// Rack settings: 42 slots x 6 values; independent DSP state for 45 mono lanes.
fx_cfg=480000; fx_st=482000; fx_on=484000; fx_buf=2400000;
fx_ready!=1 ? (memset(fx_cfg,0,252); fx_ready=1;);
fx_validate();
// Fader laws, shared by the interface and the pad routes (u = fader position 0..1):
// 0 linear, 1 log, 2 output (first tenth -inf..-70 dB, then linear in dB to 0),
// 3 log with the low end spread out (log range ^1.8), 4 whistle pitch (first 3 % = tube,
// then like 3), 5 cubic (fine control near the bottom).
function f_u2v(u,lo,hi,lg) (
  lg==2 ? (u<=.001 ? lo : u<.1 ? lo+(u/.1)*(-70-lo) : -70+70*(u-.1)/.9) :
  lg==3 ? lo*(hi/lo)^(u^1.8) :
  lg==4 ? (u<.03 ? 0 : lo*(hi/lo)^(((u-.03)/.97)^1.8)) :
  lg==5 ? lo+(hi-lo)*u*u*u :
  lg ? lo*(hi/lo)^u : lo+(hi-lo)*u;
);
function f_v2u(v,lo,hi,lg) (
  min(1,max(0, lg==2 ? (v<=lo+.1 ? 0 : v<-70 ? .1*(v-lo)/(-70-lo) : .1+.9*(v+70)/70) :
    lg==3 ? (v<=lo ? 0 : (log(v/lo)/log(hi/lo))^(1/1.8)) :
    lg==4 ? (v<5 ? 0 : .03+.97*(log(max(v,lo)/lo)/log(hi/lo))^(1/1.8)) :
    lg==5 ? (v<=lo ? 0 : ((v-lo)/(hi-lo))^(1/3)) :
    lg ? (v<=lo ? 0 : log(v/lo)/log(hi/lo)) : (v-lo)/(hi-lo)));
);
// Per parameter id: fader range and law (for links); pv = the values the engine uses (the
// sliders, with the performance links applied per sample).
pv=461000; tlo=463000; thi=463300; tlg=463600;
function settgt(id,lo,hi,lg) (tlo[id]=lo; thi[id]=hi; tlg[id]=lg;);
settgt(5,0,4,0);
settgt(6,10,8000,1);
settgt(7,-0.3,0.3,0);
settgt(8,0.25,1,0);
settgt(9,0,1,0);
settgt(10,0,1,0);
settgt(11,0.01,0.5,0);
settgt(12,0,1,0);
settgt(13,0,2,0);
settgt(14,0.3,3,0);
settgt(15,0,0.3,0);
settgt(16,20,8000,1);
settgt(17,0,1,0);
settgt(22,1,100,1);
settgt(23,1,200,1);
settgt(24,5,500,1);
settgt(25,3,1000,1);
settgt(36,0,0.3,0);
settgt(37,200,18000,1);
settgt(38,0.2,0.995,0);
settgt(39,200,18000,1);
settgt(40,0,1,0);
settgt(41,0,2,0);
settgt(42,3,300,1);
settgt(43,0,0.9995,0);
settgt(44,100,12000,1);
settgt(45,0,1,0);
settgt(46,60,8000,1);
settgt(47,0.5,3,0);
settgt(48,0,1,5);
settgt(51,4,80,1);
settgt(52,0,3,0);
settgt(53,0.02,1,0);
settgt(54,0,1,0);
settgt(55,-24,24,0);
settgt(56,1,80,1);
settgt(57,0,6,0);
settgt(58,0,1,0);
settgt(59,0,1,0);
settgt(60,0,1,0);
settgt(61,0,1,0);
settgt(62,0,1,0);
settgt(63,0,1,0);
settgt(65,0,1,0);
settgt(66,0,8,0);
settgt(67,5,500,1);
settgt(69,0.05,1,0);
settgt(70,0,1,0);
settgt(71,10,4000,4);
settgt(86,0,1,0);
settgt(87,-1,1,0);
settgt(100,0,1,0);
settgt(101,-1,1,0);
i=26; loop(5, settgt(i,.1,8,1); i+=1;);
i=142; loop(5, settgt(i,.25,4,1); settgt(i+5,.25,4,1); settgt(i+10,0,2,0); settgt(i+15,-1,1,0); i+=1;);
