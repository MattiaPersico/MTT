fader(73,134,52,60,0,"speed","%.2f×",.25,4,1);
fader(50,268,52,60,0,"wait","%.0f ms",0,3000,0);
g_inline=0; gfont(1,13);
// Theme, last at the top right: moon by day (switch to dark), sun at night (switch to light).
g_th_hit=hit(770,16,30,26);
g_th_hit && down ? col_warm() : g_th_hit ? col_text() : col_dim();
g_dark ? (
  gcircle(785,29,3.6,1);
