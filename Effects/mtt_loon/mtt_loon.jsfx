  col_panel(); grect(c1x,g_ty0-6,56,5*39+8);
  gfont(3,10); col_mark();
  label(c1x+2,g_ty0-20,"junction"); gfx_measurestr("pan",g_tw,g_tt); gfx_x=(c1x+368)*g_s-g_tw/2; gfx_y=(g_ty0-20)*g_s; gtext("pan");
  col_acc(); grect(c1x+5,g_ty0-2,3,5*39-2);
  gi=0; loop(5,
    g_ry=g_ty0+gi*39; g_bl=44*ratios[gi]*slider(147+gi)/g_bmax; g_lv=slider(152+gi);
    col_ink(min(1,.25+.35*slider41*max(.2,g_lv)));
    g_k=0; loop(max(1,floor(1+1.5*g_lv)), gline(c1x+8,g_ry+15+g_k,c1x+8+g_bl,g_ry+15+g_k); g_k+=1;);
    slider61>0 && g_lv>0 ? (col_red(min(1,.3+.7*slider61)); gcircle(c1x+9+g_bl,g_ry+15.5,1.5+2*slider61,0););
    col_mark(); gfont(3,9); at(c1x+10,g_ry+21); gfx_printf("%.1f cm",slider42*ratios[gi]*slider(147+gi));
    gfont(3,10); col_mark(); sprintf(#sec,"%d",gi+1); label(c1x+66,g_ry+9,#sec);
    gfont(3,11); g_inline=1;
    fader(147+gi,c1x+130,g_ry+7,150,0,"length","×%.2f",.25,4,1);
    fader(152+gi,c1x+130,g_ry+25,150,0,"level","%.2f",0,2,0);
    g_inline=0;
    g_knob_compact=1; knob(157+gi,c1x+368,g_ry+14,11,"Pan",slider(157+gi)<-.005?"L %.2f":slider(157+gi)>.005?"R %.2f":"C",-1,1,0); g_knob_compact=0;
    gfont(3,10);
    gi+=1;
  );
  gfont(1,13);
);
