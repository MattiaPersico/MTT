    button(c1x,129,395,24,#fx_point_label,1) ? (
      strcpy(#fx_menu,""); gi=0; loop(14,
        fx_is_main(gi) ? (gi+=1;) : (
          gi>0 ? strcat(#fx_menu,"|"); g_fx_point==gi ? strcat(#fx_menu,"!");
          strcat(#fx_menu,fx_point_name(gi));
          g_fx_count=0; gj=0; loop(3,fx_cfg[(gi*3+gj)*6]>0 ? g_fx_count+=1; gj+=1;);
          sprintf(#fx_count,"  (%d/3)",g_fx_count); strcat(#fx_menu,#fx_count); gi+=1;
        );
      );
      gfx_x=c1x*g_s; gfx_y=153*g_s; g_fx_choice=gfx_showmenu(#fx_menu);
      g_fx_choice>0 ? (g_fx_point=fx_legacy_pt(g_fx_choice-1); g_fx_drag=0;);
    );
    button(c1x,156,395,20,"Main racks",0) ? (g_fx_legacy=0; g_fx_drag=0;);
  );
  // Three serial slots for the selected point (unchanged rendering).
  g_fx_jump=0; gi=0; loop(3,
    g_fx_p=(g_fx_point*3+gi)*6; g_fx_y=164+gi*98; g_fx_t=fx_cfg[g_fx_p];
    col_panel(); grect(c1x,g_fx_y,395,91);
    col_dim(); sprintf(#fx_num,"%d",gi+1); label(c1x+8,g_fx_y+8,#fx_num);
    button(c1x+27,g_fx_y+4,157,23,fx_name(g_fx_t),0) ? (
      gfx_x=(c1x+27)*g_s; gfx_y=(g_fx_y+27)*g_s;
      g_fx_choice=gfx_showmenu("Off|Ring Mod|Flanger|Chorus|Delay|Reverb|Saturation|Disperser");
      g_fx_choice>0 ? (
        push_undo(); g_fx_new=g_fx_choice==8 ? 8 : g_fx_choice-1; fx_cfg[g_fx_p]=g_fx_new;
        gj=1; loop(5,fx_cfg[g_fx_p+gj]=fx_default(g_fx_new,gj); gj+=1;); fx_touch();
      );
    );
    g_fx_t>0 ? (
      button(c1x+188,g_fx_y+4,46,23,"Move",0) ? g_fx_jump=fx_move_menu(g_fx_p/6,c1x+188,g_fx_y+27);
      button(c1x+240,g_fx_y+4,47,23,fx_cfg[g_fx_p+5]>=.5?"ON":"OFF",fx_cfg[g_fx_p+5]>=.5) ? (
        push_undo(); fx_cfg[g_fx_p+5]=fx_cfg[g_fx_p+5]>=.5?0:1; fx_touch();
      );
      gi>0 && button(c1x+292,g_fx_y+4,29,23,"^",0) ? fx_swap(g_fx_p,g_fx_p-6);
      gi<2 && button(c1x+325,g_fx_y+4,29,23,"v",0) ? fx_swap(g_fx_p,g_fx_p+6);
      button(c1x+358,g_fx_y+4,29,23,"x",0) ? (push_undo(); fx_cfg[g_fx_p]=0; fx_touch(););
      gfont(3,10);
      fx_control(g_fx_p+1,c1x+8,g_fx_y+35,86,"Wet",g_fx_t,1);
      fx_control(g_fx_p+2,c1x+106,g_fx_y+35,86,g_fx_t==1||g_fx_t==8?"Frequency":g_fx_t<=3?"Rate":g_fx_t==4?"Time":g_fx_t==5?"Size":"Drive",g_fx_t,2);
      g_fx_t!=1 ? (
        fx_control(g_fx_p+3,c1x+204,g_fx_y+35,86,g_fx_t==8?"Amount":g_fx_t<=3?"Depth":g_fx_t==4?"Feedback":g_fx_t==5?"Decay":"Bias",g_fx_t,3);
        fx_control(g_fx_p+4,c1x+302,g_fx_y+35,85,g_fx_t==8?"Pinch":g_fx_t<=3?"Feedback":g_fx_t<=5?"Tone":"Trim",g_fx_t,4);
      );
      gfont(1,13);
    );
    gi+=1;
  );
);
g_fx_jump>0 ? (g_fx_point=g_fx_jump-1; g_fx_legacy=fx_is_main(g_fx_point)?0:1; g_fx_jump=0; g_fx_drag=0; g_fx_last_id=-1;);
!down ? g_fx_drag=0;

// Output level: always visible along the bottom (tapered fader, far left = -inf).
g_inline=1; fader(49,66,602,610,0,"Output",slider49<=-119.9?"-inf dB":"%.1f dB",-120,0,2); g_inline=0;
preview_end_check=g_prev_id>0 && hover_id!=g_prev_id; preview_end_check ? preview_end();
// ---------- help panel (bottom right): hovered control, element, or the open tab ----------
function wraptext(x,y,w,maxy,str) local(n,k,st,lw,lh) (
  n=strlen(str); k=0; st=0; strcpy(#hl,""); gfx_y=y*g_s;
  while(k<=n) (
    k==n || str_getchar(str,k)==32 ? (
      k>st ? (
        strcpy_substr(#hw,str,st,k-st);
        strcpy(#ht,#hl); strlen(#hl) ? strcat(#ht," "); strcat(#ht,#hw);
        gfx_measurestr(#ht,lw,lh);
        lw>w*g_s && strlen(#hl) ? (
          gfx_y<=maxy*g_s ? (gfx_x=x*g_s; gtext(#hl);); gfx_y+=15*g_s; strcpy(#hl,#hw);
        ) : strcpy(#hl,#ht);
      );
      st=k+1;
    );
    k+=1;
  );
  strlen(#hl) && gfx_y<=maxy*g_s ? (gfx_x=x*g_s; gtext(#hl););
);
function param_help(id) (
  id==5 ? "Subglottal pressure (1 = about 800 Pa). More: louder, brighter, closer to breaks. Pressed folds need more to start; open folds can be blown apart by too much and stop. The hint under the pad says which. Y scales it (GESTURE)." :
  id==6 ? "Mechanical frequency of the folds alone: about the output pitch with Coupling 0 and symmetric folds. Y scales it. From 10 Hz (single pulses, fry, growls) to 8 kHz for birds; lower Output when you go high." :
  id==7 ? "Glottal area at rest. Negative: pressed folds, hard onsets, need more pressure (about 1.5 at -0.1, 3 at -0.2). Positive: breathy, soft onsets; above about 0.25 the folds stop when Pressure or Coupling is high. Pressed folds make Tremor pressure and Air sac load pulse." :
  id==8 ? "Stiffness ratio of the right fold (1 = symmetric). Below about 0.6: period doubling, two pitches, chaos. Y break lowers it further in the upper half of the pad." :
  id==9 ? "How much the tract pressure acts back on the flow and the folds. 0: pitch follows Fold Hz freely. 0.1-0.3: pitch resists and jumps near resonances. Higher: pitch locks to the tract. With open folds, high Coupling moves the pressure drop into the tract and they stop." :
  id==10 ? "Turbulent noise proportional to glottal flow, injected at the glottis and filtered by the tract. Adds air and roughness, strongest on loud open phases." :
  id==11 ? "Tissue damping (the upper mass gets 6x). Low: richer, easier onsets, more unstable. High: smoother, needs more pressure." :
  id==12 ? "Spring stiffening with displacement. Large, loud vibrations get sharper in pitch and their travel is limited." :
  id==13 ? "Energy lost when the folds collide. Low: bouncy contact, sharper pulses, more irregular. High: soft closure." :
  id==14 ? "Glottal length. Longer folds pass more air: louder and more strongly coupled to the tract. Voice 2 scales from this." :
  id==15 ? "Random pressure fluctuation (relative deviation). Turns into jitter and shimmer through the folds' response." :
  id==16 ? "Bandwidth of the pressure noise. Low: slow wavering. High: grainy roughness." :
  id==17 ? "With the pressure axis on Y or X (or Z without a pen), how far that axis scales the air drive down from the Pressure fader value (the axis top is the full value, the bottom gives 1 - depth of it). 0: the axis leaves it alone." :
  id==18 ? "Fold tension range on Y: plus or minus this many octaves from the middle of the pad." :
  id==19 ? "Asymmetry added in the upper half of Y, growing towards the top (shaded orange on the pad). 0: no breaks from the pad." :
  id==20 ? "Tract length change on X: plus or minus this many octaves at the edges." :
  id==21 ? "How strongly X applies each area's X morph (TRACT tab)." :
  id==22 ? "Time constant of X/Y movements, for the mouse and the pen. Short: crisp jumps. Long: gliding transitions." :
  id==23 ? "Pressure rise time at a pad press or HOLD." :
  id==24 ? "Pressure fall time after release." :
  id==25 ? "Tract length. Shorter: higher, more widely spaced formants. X scales it." :
  id>=26 && id<=30 ? "Relative cross-section of this section (1 at the glottis, 5 at the lips). Contrasts between neighbours shape the formants; a narrow Area 1 strengthens source-tract interaction." :
  id>=147 && id<=151 ? "This branch's length, as a factor on its built-in share of Size (0.37, 0.61, 1, 1.37, 1.91). Sets which frequencies it reinforces or cancels; the drawing and the cm figure show the result. Can move while playing." :
  id>=152 && id<=156 ? "How much of the junction this branch takes (its opening): 0 disconnects it, 1 is the classic share, 2 doubles it. It weights both its pull on the tube and folds and its radiation. Coupling scales all five." :
  id>=157 && id<=161 ? "Where this branch's radiation sits in the stereo image (with Stereo width in MIX and Branch radiation above). Default: odd branches left, even ones right. Drag up or down, double-click resets." :
  id>=142 && id<=146 ? "This section's share of the tube's length (the five share Length). Equal shares: the classic tube, which has one resonance that never moves (about 5 x 343 / (4 x Length)). Uneven shares free it and let a short narrow neck or a long cavity make bottle-like, throaty resonances. Can move while playing." :
  id>=31 && id<=35 ? "How this section's area changes across X, in octaves at the pad edges (scaled by X shape)." :
  id==36 ? "Damping inside the tube. Higher: wider formants, less ringing." :
  id==37 ? "Wall losses above this frequency. Lower: duller, softer tube." :
  id==38 ? "Sound reflected back into the tube at the lips. High: sharp formants. Low: open, damped tube." :
  id==39 ? "Above this frequency less sound reflects at the lips and more escapes: brighter output, less high ringing." :
  id==40 ? "Mouth radiation load: brighter above about 700 Hz, flat above about 5 kHz; with Mouth radius set, these corners follow the lip size. 0 gives the plain pressure at the lips." :
  id==41 ? "Connection of the five side branches to the tube. 0: disconnected. They act back on the folds too." :
  id==42 ? "Scales all branch lengths. Decides which frequencies the branches reinforce or cancel." :
  id==43 ? "Reflection at the branch ends. Near 1 the branches ring; with a high Lowpass they ring for a long time." :
  id==44 ? "Branch losses above this frequency. Raise it for longer, brighter ringing." :
  id==45 ? "Blends a resonant lowpass of the pressure at the glottis: sound heard from inside the body." :
  id==46 ? "Cutoff of the throat pickup." :
  id==47 ? "Resonance of the throat pickup filter." :
  id==48 ? "Blends the glottal flow derivative: silent while the folds are closed, carries the interaction ripple. It is strong, so most of the fader's travel is below 0.2." :
  id==49 ? "Final level, from 0 dB down to silence (-inf at the far left). Most of the travel is linear in dB from -70 to 0 (about 8 pixels per dB), where voices usually sit; the first tenth fades from -70 to silence. Shift-drag for fine steps." :
  id==50 ? "Silence between loop repetitions (Play). In its second half the cursor returns to the start of the gesture." :
  id==51 ? "Resonance of the air supply (sac compliance with airway inertance). Sets the rate at which a loaded supply wobbles." :
  id==52 ? "How much the glottal flow drains the supply. 0: ideal source. Higher: pressure sags on loud phases and rebounds; near threshold the folds start and stop by themselves." :
  id==53 ? "Damping of the supply resonance. Low: ringing, long wobble. High: smooth sag." :
  id==54 ? "Second fold pair sharing pressure and tract, like the other side of a bird's syrinx. Size relative to voice 1; 0 is off. Voice interaction sets how strongly it couples to voice 1." :
  id==55 ? "Pitch of voice 2 relative to voice 1, in semitones. Non-integer intervals give two independent lines; small offsets beat." :
  id==56 ? "Average tremor rate. Bird trills: about 20-40 Hz. Rough, rhythmic pulsing: about 10-25 Hz." :
  id==57 ? "Tension modulation depth in semitones: vibrato and trills. The folds and tract respond nonlinearly, so it is not a plain vibrato." :
  id==58 ? "Random variation of tremor rate and depth. 0: clockwork. 0.5-1: organic and uneven." :
  id==60 ? "How strongly the two fold pairs interact: shared aerodynamic load, tissue coupling between them, and a shared tremor. 0: independent sides. 1: strongly coupled; close intervals pull into lock, others make sidebands." :
  id==61 ? "The open ends of the five side branches radiate too, through a highpass: their own resonances join the mouth sound. Scales with Coupling; 0 at Coupling 0. Output only: it does not act back on the folds." :
  id==62 ? "Different left and right mixes: odd branches lean left, even ones right, and the body pickup sits opposite the mouth. 0: identical mono channels. Strongest with Branch radiation up." :
  id==63 ? "Linked compressor before the soft clip. Quiet passages come up and loud ones go down, around a fixed level: denser, more even calls. 0: off." :
  id==86 ? "How far the jaw opens with a call (with Jaw depth above 0). Closed: lips nearly shut, front narrow, back wide, sound muffled and quieter (\"mm\", \"oo\"). Open: lips and front wide, back narrower, bright and loud (\"aa\"). The vowel pad below sets it together with Tongue." :
  id==87 ? "Tongue position. Back: the middle of the tube narrows and the front widens, low second formant (\"oo\", \"oh\"). Front: the back widens and the front narrows, high second formant (\"ee\"). Works without the jaw. Audible best on low voices, where the harmonics are dense enough to show the formants." :
  id==65 ? "Turns the jaw on and sets how much it reshapes the mouth. The radiated sound follows the lips too: quieter and darker as they close. Off: the tube stays as set (Tongue still works)." :
  id==66 ? "Lip radius at Area 5 = 1, in cm; the lip area scales it. Sets where sound stops reflecting and starts radiating (about 3.6 kHz at 1.5 cm). Small: ringing, thin, quieter. Large: open, warm, damped formants. 0: fixed (Mouth lowpass and the fixed load)." :
  id==67 ? "How fast the jaw opens at the start of a call (closing takes 1.5 times longer). Short: snappy, beak-like. Long: slow, wide mouth sweeps." :
  id==68 ? "How much Y decides the opening. 0: the jaw opens fully with every call. 1: only high Y opens it fully, low Y keeps it nearly shut." :
  id==69 ? "Shape of the tremor cycle. 1: smooth wobble. Lower: each cycle becomes a short burst (fast attack, decay) followed by silence, with the pitch rising and falling inside it and the jaw opening with it. With Pressure depth 1 and a low Fold Hz: staccato gluk-gluk gurgles." :
  id==70 ? "A second voice driven by the airflow, like a whistle: it sings at its own pitch while the folds keep theirs, and the two pull on each other (sidebands, an uneven inner vibration). With Whistle pitch on tube it is the tube's own resonance and starts above a threshold (about 0.5); with a set pitch it fades in gradually. X moves it, Y the folds." :
  id==71 ? "From 10 Hz (a slow inner beat) to 4 kHz. tube: the whistle is the tube's own resonance (set by Length and X). A frequency: the whistle gets its own resonator at that pitch (X still moves it), fades in smoothly with Whistle and couples into the tube. The rate of the inner vibration is the distance between this pitch and the nearest fold harmonic. Double-click: back to tube." :
  id==100 ? "With the pressure axis on Z: how much pen pressure drives the air. 1: the air drive follows the pressure (Pressure is the maximum, a light touch is soft). 0: the pen only plays the pad and the maps; the air is as with the mouse." :
  id==101 ? "Response of the pressure. Firm (up): fine control over a light touch, full air only when pressing hard. Soft (down): the air comes early. Linear in the middle." :
  id==73 ? "Playback speed of the looped gesture, 0.25x to 4x. The wait between repetitions is not scaled. Change it while the loop plays." :
  id>=74 && id<=85 && (id-74)%3==0 ? "Which pad axis drives this route: X (left to right) or Y (bottom to top). Click to switch. The smoothed pad position is used, also while Play loops a gesture." :
  id>=74 && id<=85 && (id-74)%3==1 ? "The parameter this route moves, grouped like the tabs. The pad moves it around its own fader position; the fader shows the moving value as a red tick. Mouth opening adds to the jaw (needs Jaw depth in MOUTH)." :
  id>=74 && id<=85 ? "How far the route moves its target: plus or minus this share of the fader's travel at the pad edges, zero in the middle. Negative: reversed. Routes to the same target add up." :
  id==59 ? "Pressure pulsing depth. Near 1 the pressure drops between pulses: the folds stop and restart each cycle, giving rhythmic, irregular pulses (best with pressed folds)." :
  "";
);
function tab_help(n) (
  n==8 ? "Choose a point above, then add up to three effects in order. Move sends an effect to another point. ON/OFF bypasses; arrows reorder; x removes. Drag a control horizontally (Shift: fine); double-click resets. Full points cannot receive effects. Stereo output preserves delay and reverb tails." :
  n==0 ? "Two masses per fold. Fold Hz sets the pitch, Asymmetry splits the sides into breaks, tissue settings shape the pulses, Voice 2 adds a second pair. Hover a fader bar to hear a value, click to keep it. Birds: Fold Hz 2-5 kHz, Length 4-8 cm." :
  n==1 ? "The air that drives the folds. Pressure, Rest opening (closure) and Coupling decide whether and how the folds start; the air sac is a springy supply drained by the flow, which sags and wobbles under load. Whistle lets the air make the tube sing too." :
  n==2 ? "How a performance plays the model. The pressure axis carries the air drive (Z: pen pressure, falling back to Y with the mouse). Every other parameter can be linked to an axis: right-click its fader. Here: all the links, their ranges and curves. Defaults: Y pitch, X length and area shapes, Y jaw opening." :
  n==7 ? "Muscle-like modulation of tension and pressure. Pulse width below 1 turns each cycle into a burst and a gap. Rough pulsing: Pressure depth 0.6-1 at 15-30 Hz with Rest opening around -0.03 (AIR). Staccato gurgles: Pulse width 0.3, low Fold Hz." :
  n==3 ? "Five-section tube from the glottis (left) to the lips (right). Length sets formant spacing, the areas shape the formants, X morph sets how X changes each area. The dice draws a plausible tube: two vowel shapes, X moving from one to the other, length from the pitch. The lips and the jaw are in the MOUTH tab." :
  n==6 ? "The shape of the mouth. The jaw opens with each call and closes on release, moving the first formant, the level and the brightness; the tongue moves the second formant; the vowel pad sets both. Mouth radius makes the lip size decide how much sound escapes: small mouths ring and sound thin, large ones open and direct." :
  n==4 ? "Five side branches at the junction between areas 2 and 3. They return pressure into the tube and act back on the folds: extra resonances, cancellations, ringing. Size scales all branch lengths; Branch radiation lets their open ends sound too." :
  "Pickups and stereo. Throat and Flow pickups add sound from inside the body. Stereo width splits the branches left and right; Compression evens out the level. The trace shows the output. Output level is at the bottom of the window.";
);
hx=405;hy=468;hw=395;hh2=112;
col_panel();grect(hx,hy,hw,hh2);
hover_id>0 ? (
  (hover_id>=26 && hover_id<=35) || (hover_id>=142 && hover_id<=161) ? sprintf(hover_lbl=#hsec,hover_id<=30?"Area %d":hover_id<=35?"X morph %d":hover_id<=146?"Length %d":hover_id<=151?"Branch %d length":hover_id<=156?"Branch %d level":"Branch %d pan",hover_id<=30?hover_id-25:hover_id<=35?hover_id-30:hover_id<=146?hover_id-141:hover_id<=151?hover_id-146:hover_id<=156?hover_id-151:hover_id-156);
  col_acc();label(hx+8,hy+7,hover_id==50?"Loop wait":hover_id==73?"Loop speed":hover_id>=76 && hover_id<=85 && (hover_id-76)%3==0?"Route amount":hover_lbl);
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,param_help(hover_id));
) : hit(770,16,30,26) ? (
  col_acc();label(hx+8,hy+7,g_dark?"Light theme":"Dark theme");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Switches between the day look (ink on paper) and the night look (paper on ink). Saved with the project; not an undo step.");
) : hit(540,16,166,24) ? (
  col_acc();label(hx+8,hy+7,"Pen tablet");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Plays the pad with a pen through the MTT Tablet Bridge extension: the whole tablet is the pad (X, Y), pen pressure is the air drive (Pressure is the maximum); GESTURE > Pen sets what else the pen moves. The pen owns the pad while on; the mouse still works everywhere else. Not restored with the project, not automation. Turn it off before rendering.");
) : hit(400,47,150,18) ? (
  col_acc();label(hx+8,hy+7,"Parameters Preview");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"On: resting the pointer on a fader's bar plays the value under it, and leaving restores the previous one; click to keep it. Off: faders change only when you click or drag. Saved with the project.");
) : hit(20,70,360,360) ? (
  col_acc();label(hx+8,hy+7,tb_owned ? "XY pad  ·  the pen plays it" : "XY pad");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,tb_owned ? "The pen is on: it plays the pad and the mouse cannot. X and Y cover the whole tablet; pen pressure sets the air drive. Each pen gesture is recorded for Play, with its pressure. Turn the pen off (pen icon) to play with the mouse again." : "Hold and move to play. The pad's X and Y (or the pen's) play every linked parameter (GESTURE lists them; by default Y pitch and jaw, X length and tube shape) and, on the pressure axis, the air. The loon is only a landmark. Each gesture is recorded for Play. Wheel zooms at the pointer, right-drag pans, FIT resets the view.");
) : hit(718,16,50,26) ? (
  col_acc();label(hx+8,hy+7,"UNDO / REDO  (Cmd/Ctrl+Z, Shift+Cmd/Ctrl+Z)");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Steps back and forth through parameter changes made in this window (clicks, drags, double-click resets) and recorded pad gestures: up to 100 steps. Hover previews are not steps until you click.");
) : hit(20,47,20,18) ? (
  col_acc();label(hx+8,hy+7,"PLAY  (key L)");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Loops the last pad gesture forever, at the set speed, with the wait between repetitions. Change any parameter while it plays. After a pause it continues from where it stopped. Drawing a new gesture stops the loop; UNDO brings the previous take back.");
) : hit(42,47,20,18) ? (
  col_acc();label(hx+8,hy+7,"PAUSE  (key H)");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Holds the sound where it is: during a loop, at the current point of the gesture; otherwise at the pad point. Tune parameters on a steady sound. Clicking the pad moves the held point without recording a take. Press again (or Play) to go on.");
) : hit(64,47,20,18) ? (
  col_acc();label(hx+8,hy+7,"STOP");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Ends the loop and the pause. The recorded gesture stays: Play starts it again from the beginning.");
) : hover_id==-89 ? (
  col_acc();label(hx+8,hy+7,"Remove link");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"The parameter goes back to its fader alone. UNDO brings the link back.");
) : hover_id==-88 ? (
  col_acc();label(hx+8,hy+7,"Link a parameter");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Pick any parameter to tie to a performance axis. A new link covers its full range on Y; the fader still moves the range. You can narrow it by dragging an end. The same works with a right-click on any fader or knob.");
) : hover_id==-95 ? (
  col_acc();label(hx+8,hy+7,"Pressure axis");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"The axis that carries the air drive, the base of every call. Z: pen pressure (Z to air and Z curve shape it); with the mouse, or a pen held in PAUSE, it falls back to Y. Y or X: the pad (or pen) position raises and lowers it around the middle by X/Y depth, as Y effort always did.");
) : hover_id<=-200 ? (
  g_ht=floor((-hover_id-200)/4); g_hp=(-hover_id-200)%4;
  g_hp==0 ? (
    sprintf(#pr,"%s  ·  linked to %s",tgt_name(g_ht),axis_name(lk_a[g_ht]-1));
    col_acc();label(hx+8,hy+7,#pr);
    col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Click to open its tab: the fader shows the range under its bar, two ticks you can drag. Right-click the fader to change the axis or the curve, or to remove the link.");
  ) : g_hp==1 ? (
    col_acc();label(hx+8,hy+7,"Axis");
    col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"X and Y: the pad position, or the pen's on the tablet. Z: pen pressure (0 in the air); without a pen a Z link rests at its fader. Click to change.");
  ) : g_hp==2 ? (
    g_ht>0 && g_ht<250 ? (g_u=f_v2u(slider(g_ht),tlo[g_ht],thi[g_ht],tlg[g_ht]);
      sprintf(#pr,"%s: %.4g to %.4g",tgt_name(g_ht),f_u2v(min(1,max(0,g_u+lk_lo[g_ht])),tlo[g_ht],thi[g_ht],tlg[g_ht]),f_u2v(min(1,max(0,g_u+lk_hi[g_ht])),tlo[g_ht],thi[g_ht],tlg[g_ht]));
    ) : strcpy(#pr,"Range");
    col_acc();label(hx+8,hy+7,#pr);
    col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Where the axis takes the parameter, anchored to its fader (grey mark): the two ticks are \"from\" (axis at 0) and \"to\" (axis at 1); \"to\" can sit left of \"from\" to reverse. Moving the fader moves the range, clipped at its limits. Drag either end to narrow or reshape it; double-click: full range.");
  ) : (
    col_acc();label(hx+8,hy+7,"Curve");
    col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Drag up for a firm curve (fine control at the start of the axis, the value rises late), down for a soft one (rises early). Double-click: straight. The dot is the axis now.");
  );
) : hover_id==-2 ? (
  col_acc();label(hx+8,hy+7,"Vowel pad");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Drag to shape the mouth: left and right move the tongue (back \"u\", front \"i\"), up opens the jaw (\"a\"). The light dot is the set shape, the small dark one the jaw as it moves now. Turns Jaw depth on if it is off.");
) : hover_id==-3 ? (
  col_acc();label(hx+8,hy+7,"Loop position");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Where the loop is in the recorded gesture, start to end (full during the wait). Drag it to jump; with PAUSE on, dragging walks the sound along the recorded path by hand.");
) : g_dice_hover && !g_rv ? (
  col_acc();label(hx+8,hy+7,"Dice");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Draws new values for this tab that make sense together and with the rest: the air so the folds can start, the pitch from the tract length, sizes from the pitch. If the voice is playing and the folds stay still, it corrects the air a few times. One undo step.");
) : g_rv ? (
  col_acc();label(hx+8,hy+7,"Random voice");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"A whole creature at once: a size from a small bird to a large animal sets the tract length, and air, folds, pulses, tract, cavities and mouth are drawn around it. The playing setup (GESTURE) and the mix stay. Play a pad gesture or PAUSE to hear it. One undo step.");
) : hit(20,438,360,140) ? (
  col_acc();label(hx+8,hy+7,"Status");
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,"Pressure at the folds, total glottal area and output level. The trace shows the glottal area over about six cycles: alternating pulse heights mean period doubling, uneven pulses mean chaos.");
) : (
  hover_tab=page; gi=0; loop(9, hit(tab_left(gi),70,tab_size(gi),26) ? hover_tab=tab_page(gi); gi+=1;);
  col_acc();label(hx+8,hy+7,tab_name(hover_tab));
  col_dim();wraptext(hx+8,hy+25,hw-16,hy+hh2-15,tab_help(hover_tab));
  gfx_x=(hx+hw-8)*g_s;
);
prev_down=down; g_prev_r=mouse_cap&2;
