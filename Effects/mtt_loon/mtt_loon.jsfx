// Takes: a new recorded take becomes an undo step; the snapshot keeps the previous take.
g_init!=1 ? (g_new_seen=take_new; g_take=take_active; g_init=1;);
take_new!=g_new_seen ? (push_undo(); g_take=take_active; g_new_seen=take_new;) :
  take_req==0 && take_active!=g_take ? g_take=take_active;
arrowbutton(718,16,24,26,1,undo_n>0) || ((key==26 || ((key==122 || key==90) && (mouse_cap&36))) && !(mouse_cap&8)) ? do_undo();
