        strcat(#fx_menu,fx_rack_name(gi));
        g_fx_count=0; gj=0; loop(3,fx_cfg[(fx_main_point(gi)*3+gj)*6]>0 ? g_fx_count+=1; gj+=1;);
        sprintf(#fx_count,"  (%d/3)",g_fx_count); strcat(#fx_menu,#fx_count); gi+=1;
      );
