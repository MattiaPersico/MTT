    col_warm(); gfx_measurestr(str,tw,th);
    g_inline ? label(x-6-tw/g_s-11,y,axis_name(lk_a[id]-1)) : label(x+tw/g_s+5,y,axis_name(lk_a[id]-1));
    col_red(.45); grect(x+w*min(ul,uh),y+by+8,max(1,w*abs(uh-ul)),2);
    nr==2 || g_ldrag==id && g_lwhich==2 ? col_text() : col_warm(); grect(x+w*ul-1,y+by+6,2,7);
    nr==3 || g_ldrag==id && g_lwhich==3 ? col_text() : col_warm(); grect(x+w*uh-1,y+by+6,2,7);
  );
