  g_ml[n]=-1; n+=1; g_ml[n]=4; n+=1; g_ml[n]=25; n+=1; g_ml[n]=36; n+=1; g_ml[n]=37; n+=1; g_ml[n]=26; n+=1; g_ml[n]=27; n+=1; g_ml[n]=28; n+=1; g_ml[n]=29; n+=1; g_ml[n]=30; n+=1; g_ml[n]=142; n+=1; g_ml[n]=143; n+=1; g_ml[n]=144; n+=1; g_ml[n]=145; n+=1; g_ml[n]=-2; n+=1; g_ml[n]=146; n+=1;
  g_ml[n]=-1; n+=1; g_ml[n]=5; n+=1; g_ml[n]=41; n+=1; g_ml[n]=42; n+=1; g_ml[n]=43; n+=1; g_ml[n]=44; n+=1; g_ml[n]=61; n+=1; g_ml[n]=147; n+=1; g_ml[n]=148; n+=1; g_ml[n]=149; n+=1; g_ml[n]=150; n+=1; g_ml[n]=151; n+=1; g_ml[n]=152; n+=1; g_ml[n]=153; n+=1; g_ml[n]=154; n+=1; g_ml[n]=155; n+=1; g_ml[n]=156; n+=1; g_ml[n]=157; n+=1; g_ml[n]=158; n+=1; g_ml[n]=159; n+=1; g_ml[n]=160; n+=1; g_ml[n]=-2; n+=1; g_ml[n]=161; n+=1;
  g_ml[n]=-1; n+=1; g_ml[n]=6; n+=1; g_ml[n]=65; n+=1; g_ml[n]=86; n+=1; g_ml[n]=67; n+=1; g_ml[n]=87; n+=1; g_ml[n]=66; n+=1; g_ml[n]=40; n+=1; g_ml[n]=38; n+=1; g_ml[n]=-2; n+=1; g_ml[n]=39; n+=1;
  g_ml[n]=-1; n+=1; g_ml[n]=7; n+=1; g_ml[n]=45; n+=1; g_ml[n]=46; n+=1; g_ml[n]=47; n+=1; g_ml[n]=48; n+=1; g_ml[n]=62; n+=1; g_ml[n]=-2; n+=1; g_ml[n]=63; n+=1;
  g_ml[n]=-1; n+=1; g_ml[n]=8; n+=1; g_ml[n]=17; n+=1; g_ml[n]=100; n+=1; g_ml[n]=101; n+=1; g_ml[n]=23; n+=1; g_ml[n]=24; n+=1; g_ml[n]=-2; n+=1; g_ml[n]=22; n+=1;
  // Build the menu string; g_mi = ids of the selectable items in order.
  g_mi=462300; strcpy(#rmenu,""); k=0; t=0;
  while(k<n) (
    id=g_ml[k];
    id==-1 ? (k+=1; id=g_ml[k];
      strcat(#rmenu,id==1?"|>AIR" : id==2?"|>SOURCE" : id==3?"|>PULSE" : id==4?"|>TRACT" : id==5?"|>CAVITIES" : id==6?"|>MOUTH" : id==7?"|>MIX" : id==8?"|>GESTURE" : "");
    ) : id==-2 ? (k+=1; id=g_ml[k];
      strcat(#rmenu,"|<"); id==cur ? strcat(#rmenu,"!"); strcat(#rmenu,tgt_name(id)); g_mi[t]=id; t+=1;
    ) : (
      id==0 ? strcat(#rmenu,cur==0?"!none":"none") :
      (strcat(#rmenu,"|"); id==cur ? strcat(#rmenu,"!"); strcat(#rmenu,tgt_name(id)););
      g_mi[t]=id; t+=1;
    );
    k+=1;
  );
  gfx_x=x*g_s; gfx_y=y*g_s; r=gfx_showmenu(#rmenu);
  r>0 && r<=t ? g_mi[r-1] : -1;
);
// ---------- dice: coherent random settings ----------
// Each tab's dice draws values that work together and with the other tabs: the air is
// drawn so the folds can start (pressure above the threshold of the rest opening), the
// folds' pitch follows the tract length (a big body, a low voice), the tract and cavity
// sizes follow the pitch. After a dice, if the voice is sounding but the folds stay still,
// the "folds still" diagnosis nudges Pressure or Rest opening a few times (see below).
// rand(x) never goes below rand(1) in EEL2 (a max under 1 counts as 1): scale rand(1).
function rnd(lo,hi) (lo+rand(1)*(hi-lo););
function rlog(lo,hi) (lo*(hi/lo)^rand(1););
function chance(p) (rand(1)<p;);
// Pressure the folds need to start, fitted to offline runs of this model (fold length from
// the pitch as the SOURCE dice draws it): pressed folds (rest < 0) need more with pitch,
// about 1.5 at -0.1 and 600 Hz, >4 at 3 kHz; open folds need more with damping and pitch.
function p_thr(r,f,d) (r<0 ? max(.08,3.8*(-r)*(f/60)^.6) : max(.08,200*r*d*(f/600)^.55););
function rnd_air() local(r,p,n) (
  // Mostly pressed or just touching; open (breathy) folds less often and not far.
  r=chance(.55) ? rnd(-.14,0) : rnd(0,.07);
  // Too high a threshold for this pitch and damping: bring the rest opening towards 0.
  n=0; while(n<10 && p_thr(r,slider6,slider11)*1.3>4) (r*=.6; n+=1;);
  p=min(4,max(.6,p_thr(r,slider6,slider11)*rnd(1.5,2.4)));
  setparam(7,r); setparam(9,r>0 ? rnd(.03,.25) : rnd(.05,.45));
  setparam(10,chance(.6) ? rnd(0,.15) : rnd(.15,.45));
  // Open folds lose the drive easily: keep their supply load light.
  setparam(51,rlog(8,40)); setparam(52,chance(.5) ? 0 : r>0 ? rnd(0,.3) : rnd(.2,1.2)); setparam(53,rnd(.08,.5));
  // A loaded supply sags: give it more pressure.
  slider52>0 ? p=min(4,p*(1+.5*slider52));
  setparam(5,p);
  setparam(15,chance(.5) ? 0 : rnd(.005,.06)); setparam(16,rlog(40,2000));
  setparam(70,chance(.65) ? 0 : rnd(.25,.65)); setparam(71,chance(.5) ? 0 : rlog(150,2500));
);
// Pitch from the tract length: about 600 Hz at 8 cm, an octave lower per doubled length.
function rnd_source() local(f,d) (
  f=min(5000,max(20,600*(8/slider25)^.9*2^rnd(-1.2,1.2)));
  setparam(8,chance(.6) ? rnd(.85,1) : rnd(.45,.85));
  // Keep the folds able to start at the present pressure and rest opening: limit the pitch
  // of pressed folds and the damping of open ones.
  slider7<0 ? f=min(f,max(20,60*((slider5/1.3)/(3.8*(-slider7)))^(1/.6)));
  setparam(6,f); setparam(14,min(3,max(.3,1.4*(600/f)^.3*2^rnd(-.4,.4))));
  d=rnd(.04,.2); slider7>0 ? d=min(d,slider5/1.5/(200*slider7*(f/600)^.55));
  setparam(11,max(.01,d));
  setparam(12,rnd(0,.4)); setparam(13,rnd(.6,1.4));
  chance(.35) ? (
    setparam(54,rnd(.3,.8)); setparam(60,rnd(.1,.8));
    d=floor(rand(9)); setparam(55,(d==0?-12:d==1?-7:d==2?-5:d==3?-3:d==4?3:d==5?4:d==6?5:d==7?7:12)+rnd(-.3,.3));
  ) : setparam(54,0);
);
function rnd_pulse() local(k) (
  k=rand(1);
  k<.25 ? (setparam(57,0); setparam(59,0); setparam(69,1); setparam(56,rlog(4,35));) :
  k<.7 ? (setparam(56,rlog(4,35)); setparam(57,rnd(.2,2)); setparam(59,rnd(0,.3)); setparam(69,1);) :
  (setparam(56,rlog(3,25)); setparam(59,rnd(.6,1)); setparam(57,rnd(0,2)); setparam(69,chance(.5) ? 1 : rnd(.2,.6)););
  setparam(58,rnd(0,.7));
);
// Area profiles (glottis to lips) after the common vowel shapes: /a/ narrow back, wide
// front; /i/ wide back, narrow front; /u/ rounded small lips; /e/ and /o/ between. Areas:
// geometric middle of two of them with some jitter; each area's X link goes from one to the
// other across the pad (with X shape 1). Length follows the pitch unless kept.
function rnd_tract(keep_len) local(a,b,k,pa,pb,j) (
  g_vow=462100;
  g_vow[0]=1; g_vow[1]=.6; g_vow[2]=1.5; g_vow[3]=3; g_vow[4]=2.5;
  g_vow[5]=2.5; g_vow[6]=3; g_vow[7]=1; g_vow[8]=.3; g_vow[9]=1.2;
  g_vow[10]=1.5; g_vow[11]=2; g_vow[12]=1.2; g_vow[13]=.8; g_vow[14]=.25;
  g_vow[15]=1.8; g_vow[16]=2; g_vow[17]=1.2; g_vow[18]=.6; g_vow[19]=1.5;
  g_vow[20]=1.2; g_vow[21]=1; g_vow[22]=1.5; g_vow[23]=1.5; g_vow[24]=.5;
  a=floor(rand(5)); b=(a+1+floor(rand(4)))%5;
  k=0; loop(5,
    pa=g_vow[a*5+k]; pb=g_vow[b*5+k]; j=2^rnd(-.3,.3);
    setparam(26+k,min(8,max(.1,sqrt(pa*pb)*j)));
    // Area k follows X from one vowel to the other (its link: octaves over the fader's log travel).
    j=min(2,max(-2,.5*log(pb/pa)/log(2)+rnd(-.15,.15)))/(log(80)/log(2)); lk_set(26+k,0,-j,j);
    k+=1;
  );
  !keep_len ? setparam(25,min(80,max(3,8*(600/slider6)^.7*2^rnd(-.7,.7))));
  setparam(36,rlog(.004,.05)); setparam(37,rlog(3000,16000));
  // Half the time equal sections, otherwise uneven ones (a short neck, a long cavity...).
  k=0; loop(5, setparam(142+k,chance(.5) ? 1 : rlog(.4,2.5)); k+=1;);
  chance(.5) ? (k=0; loop(5, setparam(142+k,1); k+=1;););
);
function rnd_cavities() local(c) (
  c=chance(.3) ? 0 : rnd(.2,1.2); setparam(41,c);
  setparam(42,min(300,max(3,slider25*1.75*2^rnd(-1.2,1.2))));
  // Strong coupling with ringing branches can hold the folds: keep the reflection lower.
  setparam(43,c>.8 ? rnd(.9,.97) : rnd(.9,.995));
  setparam(44,rlog(1500,10000)); setparam(61,chance(.5) ? 0 : rnd(.1,.6));
  // Half the time the classic branches, otherwise each with its own length, level and pan.
  chance(.5) ? (c=0; loop(5, setparam(147+c,1); setparam(152+c,1); setparam(157+c,c%2 ? 1 : -1); c+=1;);) :
  (c=0; loop(5, setparam(147+c,rlog(.5,2)); setparam(152+c,rnd(.3,1.5)); setparam(157+c,rnd(-1,1)); c+=1;););
);
function rnd_mouth() (
  setparam(65,rnd(.4,1)); setparam(86,rnd(.5,1)); setparam(87,rnd(-1,1));
  setparam(67,rlog(15,200));
  // The jaw opening follows Y by a random share (its link: from a lower opening up to the set one).
  lk_set(86,1,-slider86*rnd(0,1),0);
  setparam(66,chance(.4) ? 0 : rnd(.8,4)); setparam(40,rnd(.6,1));
  setparam(38,rnd(.85,.98)); setparam(39,rlog(2000,12000));
);
function rnd_gesture() local(j) (
  setparam(17,rnd(.3,.9)); setparam(22,rlog(4,40)); setparam(23,rlog(3,60)); setparam(24,rlog(15,250));
  // Pitch on Y and length on X: random spans (octaves over the faders' log travel).
  j=rnd(.1,1.2)/(log(800)/log(2)); lk_set(6,1,-j,j);
  j=rnd(-1,1)/(log(1000/3)/log(2)); lk_set(25,0,-j,j);
);
// Output level and compression are left alone.
function rnd_mix() (
  setparam(45,chance(.5) ? 0 : rnd(.05,.4)); setparam(46,rlog(200,3000)); setparam(47,rnd(.5,2));
  setparam(48,chance(.6) ? 0 : rnd(.005,.06)); setparam(62,rnd(0,.7));
);
// A whole creature: a size from small bird to large animal sets the tract length, and
// every section is drawn around it (playing setup and mix stay).
function rnd_voice() (
  setparam(25,5*12^rand(1)*2^rnd(-.3,.3));
  rnd_source(); rnd_air(); rnd_pulse(); rnd_tract(1); rnd_cavities(); rnd_mouth();
);
function dice_roll(pg) (
  push_undo();
  pg==1 ? rnd_air() : pg==0 ? rnd_source() : pg==7 ? rnd_pulse() : pg==3 ? rnd_tract(0) :
  pg==4 ? rnd_cavities() : pg==6 ? rnd_mouth() : pg==2 ? rnd_gesture() : pg==5 ? rnd_mix() : rnd_voice();
  // Watch the result for a moment (see the check after the pad).
  g_dk_t=time_precise()+.6; g_dk_n=0;
);
// Dice button (14x14 points at x, y); true on a click.
function dice(x,y) local(over) (
  over=hit(x-3,y-3,20,20);
  over && down ? col_warm() : over ? col_text() : col_dim();
  grectf(x,y,14,14,0); gcircle(x+4,y+4,1.3,1); gcircle(x+7,y+7,1.3,1); gcircle(x+10,y+10,1.3,1);
  over ? g_dice_hover=1;
  press && over;
);
// Random voice (header): a whole creature at once (one undo step).
g_rv=hit(568,46,110,20);
dice(570,49) || (press && g_rv && !hit(567,46,20,20)) ? dice_roll(-1);
g_rv && down ? col_warm() : g_rv ? col_text() : col_dim(); label(590,49,"Random voice");
// ---------- XY pad (wheel = zoom at the pointer, right-drag = pan) ----------
px=20;py=70;pw=360;ph=360;
zoom<1 ? (zoom=1; vx=vy=0;);
span=1/zoom;
function clampview() (span=1/zoom; vx=min(1-span,max(0,vx)); vy=min(1-span,max(0,vy)););
function to_px(v) (px+(v-vx)*zoom*pw;);
function to_py(v) (py+ph-(v-vy)*zoom*ph;);
function in_view(x,y) (x>=vx-.0001 && x<=vx+span+.0001 && y>=vy-.0001 && y<=vy+span+.0001;);
// Horizontal band in value space, clipped to the visible window.
function vband(y0,y1) local(a,b) (
  a=max(y0,vy); b=min(y1,vy+span);
  b>a ? grect(px,to_py(b),pw,max(1,to_py(a)-to_py(b)));
);
mouse_wheel!=0 ? (
  hit(px,py,pw,ph) ? (
    wux=vx+(g_mx-px)/pw*span; wuy=vy+(1-(g_my-py)/ph)*span;
    zoom=min(32,max(1,zoom*2^(mouse_wheel/120*.25)));
    span=1/zoom; vx=wux-(g_mx-px)/pw*span; vy=wuy-(1-(g_my-py)/ph)*span; clampview();
  ) : g_wheel=mouse_wheel;
  mouse_wheel=0;
);
rdown=mouse_cap&2;
rdown && !prev_rdown && hit(px,py,pw,ph) ? (pan_on=1; pan_mx=g_mx; pan_my=g_my; pan_vx=vx; pan_vy=vy;);
!rdown ? pan_on=0;
pan_on ? (vx=pan_vx-(g_mx-pan_mx)/pw*span; vy=pan_vy+(g_my-pan_my)/ph*span; clampview(););
prev_rdown=rdown;
col_panel();grect(px,py,pw,ph);
// The flying loon, printed faintly on the pad in value space (it zooms and pans with the
// view) as landmarks for playing. Image rect in pad values: x .05-.95, y centred.
g_wx0=.05; g_wx1=.95; g_wy0=.5-.45*610/720; g_wy1=.5+.45*610/720;
g_cx0=max(g_wx0,vx); g_cx1=min(g_wx1,vx+span); g_cy0=max(g_wy0,vy); g_cy1=min(g_wy1,vy+span);
g_cx1>g_cx0 && g_cy1>g_cy0 ? (
  gfx_a=g_dark ? .07 : .06;
  gfx_blit(g_dark?5:4,1,0,
    720*(g_cx0-g_wx0)/(g_wx1-g_wx0),610*(g_wy1-g_cy1)/(g_wy1-g_wy0),
    720*(g_cx1-g_cx0)/(g_wx1-g_wx0),610*(g_cy1-g_cy0)/(g_wy1-g_wy0),
    to_px(g_cx0)*g_s,to_py(g_cy1)*g_s,(to_px(g_cx1)-to_px(g_cx0))*g_s,(to_py(g_cy0)-to_py(g_cy1))*g_s);
  gfx_a=1;
);
// Grid: quarter lines at 1x, finer as the zoom grows.
gstep=.25/2^floor(log(zoom)/log(2));
col_grid();
gv=ceil(vx/gstep)*gstep; while(gv<=vx+span+.00001) (gx=to_px(gv); gx>px && gx<px+pw-1 ? gline(gx,py,gx,py+ph-1); gv+=gstep;);
gv=ceil(vy/gstep)*gstep; while(gv<=vy+span+.00001) (gy=to_py(gv); gy>py && gy<py+ph-1 ? gline(px,gy,px+pw-1,gy); gv+=gstep;);
// Draws a recorded gesture path (buf = (time,x,y,z) quadruplets, n points) as a solid
// pressure-tapered stroke. Rendered as overlapping filled circles (gfx_circle) spaced
// along each segment: rotationally symmetric, so no joint artifacts. Width scales with
// zoom and panel size (same factor as to_px/to_py). Thickness = recorded pressure
// (a pen take; a mouse take draws at full weight), curved so light pressure is thin.
// Tune: base .004, range .03, exponent 1.6 (fractions of panel width).
function draw_path(buf,n,a) local(gi,x0,y0,x1,y1,cx0,cy0,cx3,cy3,g_sx,g_sy,g_ex,g_ey,g_dx,g_dy,g_len,ws,we,sp,tt,cx2,cy2,wp,t,t2,t3,h00,h10,h01,h11,m1x,m1y,m2x,m2y,move_a,align,taper,pen_a,p0m,p1m) (
  col_red(a);
  pen_a=$pi*.25;
  gi=0; loop(n-1,
    x0=buf[gi*4+1]; y0=buf[gi*4+2]; x1=buf[(gi+1)*4+1]; y1=buf[(gi+1)*4+2];
    in_view(x0,y0) && in_view(x1,y1) ? (
      g_sx=to_px(x0); g_sy=to_py(y0); g_ex=to_px(x1); g_ey=to_py(y1);
      cx0=to_px(gi>0 ? buf[(gi-1)*4+1] : x0);
      cy0=to_py(gi>0 ? buf[(gi-1)*4+2] : y0);
      cx3=to_px(gi+2<n ? buf[(gi+2)*4+1] : x1);
      cy3=to_py(gi+2<n ? buf[(gi+2)*4+2] : y1);
      g_dx=g_ex-g_sx; g_dy=g_ey-g_sy; g_len=sqrt(g_dx*g_dx+g_dy*g_dy);
      g_len<.01 ? 0 : (
        p_ax==0 ? p0m=buf[gi*4+3] : p_ax==1 ? p0m=max(0,1-slider17*(1-buf[gi*4+2])) : p0m=max(0,1-slider17*(1-buf[gi*4+1]));
        p_ax==0 ? p1m=buf[(gi+1)*4+3] : p_ax==1 ? p1m=max(0,1-slider17*(1-buf[(gi+1)*4+2])) : p1m=max(0,1-slider17*(1-buf[(gi+1)*4+1]));
        ws=.08+9.0*pow(min(1,pv[5]*p0m),1.6);
        we=.08+9.0*pow(min(1,pv[5]*p1m),1.6);
        move_a=atan2(g_dy,g_dx);
        align=.3+.7*abs(cos(pen_a-move_a));
        taper=.4+.6*sin((gi+.5)/(n-1)*$pi);
        sp=max(.03,(ws+we)*.15*align*taper);
        m1x=(g_ex-cx0)*.25; m1y=(g_ey-cy0)*.25;
        m2x=(cx3-g_sx)*.25; m2y=(cy3-g_sy)*.25;
        tt=0; while(tt<g_len) (
          t=tt/g_len; t2=t*t; t3=t2*t;
          h00=2*t3-3*t2+1; h10=t3-2*t2+t; h01=-2*t3+3*t2; h11=t3-t2;
          cx2=h00*g_sx+h10*m1x+h01*g_ex+h11*m2x;
          cy2=h00*g_sy+h10*m1y+h01*g_ey+h11*m2y;
          wp=max(.15,(ws+(we-ws)*t)*align*taper);
          gcircle(cx2,cy2,wp*.5,1);
          tt+=sp;
        );
        gcircle(g_ex,g_ey,max(.15,we*align*taper)*.5,1);
      );
    );
    gi+=1;
  );
);
// The committed take, plus (while recording) the live in-progress take from takebuf, so
// the stroke is visible while you perform, not only on release.
rec_n>=2 ? draw_path(recbuf,rec_n,.7);
recording && take_n>=2 ? draw_path(takebuf,take_n,.7);
// Zoom badge with FIT button, and a minimap of the visible window.
fit_hit=0;
zoom>1.001 ? (
  col_veil(.9);grect(px+pw-112,py+6,106,22);
  col_text();at(px+pw-106,py+10);gfx_printf("×%.1f",zoom);
  fit_hit=hit(px+pw-52,py+6,46,22);
  fit_hit ? col_hover() : col_panel();grect(px+pw-52,py+6,46,22);
  col_text();label(px+pw-43,py+10,"FIT");
  press && fit_hit ? (zoom=1;vx=vy=0;span=1;);
  col_veil(.9);grect(px+8,py+ph-60,52,52);
  col_line();grectf(px+9,py+ph-59,50,50,0);
  col_acc();grectf(px+9+50*vx,py+ph-9-50*(vy+span),max(2,50*span),max(2,50*span),0);
);
// While the pen owns the pad the mouse cannot play it (or overwrite the pen's point).
tb_owned && gui_drag ? (setparam(4,0); gui_drag=0; gui_live=0;);
press && hit(px,py,pw,ph) && !fit_hit && !tb_owned ? (
  hold_on && loop_on ? (loop_on=0; loop_play=0;);
  setparam(1,0);setparam(4,1);gui_drag=1;gui_live=1;gui_tick=time_precise();
  // A mode change must not clear this new gesture at the next audio block.
  last_mode=0;
);
gui_drag && down ? (
  setparam(2,min(1,max(0,vx+(g_mx-px)/pw*span)));
  setparam(3,min(1,max(0,vy+(1-(g_my-py)/ph)*span)));gui_tick=time_precise();
);
loop_drive ? (dvx=loop_x;dvy=loop_y;) : (dvx=slider2;dvy=slider3;);
in_view(dvx,dvy) ? (
  dotx=to_px(dvx);doty=to_py(dvy);
  gate ? (loop_drive ? col_red(.2) : col_ink(.15);gcircle(dotx,doty,8+14*gate_env,1););
  loop_drive ? col_warm() : col_ink(1); gcircle(dotx,doty,gate ? 4 : 2.5,1);
);
in_view(sx,sy) ? (col_ink(.45);gcircle(to_px(sx),to_py(sy),2,1););
// Pen near the tablet but not touching: a small dot where it would play.
