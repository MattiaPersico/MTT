// MTT shared FX library: Saturation (FX type 6). Needs mtt_fx_core. API card: lib/README.md.
// Biased soft saturation with zero output at zero input. A: drive 0-36 dB, B: bias
// (0.5 = symmetric), C: output trim -18..0 dB. No state, no arena.
@init
function fx_saturation_targets(q,r,a,b,c) (q[18]=10^(36*a/20); q[19]=b; q[20]=c;);
function fx_saturation_run(q,x) local(d,z) (
  d=(q[3]-.5); z=q[2]*x+d;
  (z/sqrt(1+z*z)-d/sqrt(1+d*d))*10^((-18+18*q[4])/20);
);
