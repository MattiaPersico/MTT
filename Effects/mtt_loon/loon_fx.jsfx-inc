// Loon's insert rack: the topology around the shared FX modules (mtt_fx_*.jsfx-inc, vendored
// from lib/fx/; API card in lib/README.md). Config: type, mix, A, B, C, enabled (42 x 6).
// 14 insertion points x 3 slots. Slots 0-38 are mono lanes at the internal rate (ir); the stereo
// output slots 39-41 run as lanes 39-41 (left) and 42-44 (right) at the host rate.
// Loon-specific here: lane rates and order (fx_run / fx_count), the Convolver's IR entries owned
// by slots (at most CONV_NI engines in total, the stereo output point uses two), the Resonance
// Suppressor's stereo link, Delay/Reverb damping up to 16 kHz, and the Ring Mod on the air
// pressure (point 0) multiplying by 0..1.
// All functions use local temporaries; @gfx only writes the configuration bank.
@init
// Entry owned by a Convolver slot (stored in the first value of the slot's curve record as
// (entry + 1) / 16, which the move / swap / undo / save paths already carry), or -1.
function conv_entry(slot) local(e) (e=floor(fx_curve[slot*65]*16+.5)-1; e>=0 && e<CONV_NI ? e : -1;);
// Gives a Convolver slot a free entry (none if all are taken). Returns the entry or -1.
function conv_assign(slot) local(k,e,f) (
  memset(conv_tab+400,0,CONV_NI);
  k=0; loop(42, k!=slot && fx_cfg[k*6]==10 ? (e=conv_entry(k); e>=0 ? conv_tab[400+e]=1;); k+=1;);
  f=-1; e=0; loop(CONV_NI, f<0 && conv_tab[400+e]==0 ? f=e; e+=1;);
  f>=0 ? (fx_curve[slot*65]=(f+1)/16; conv_clear(f);) : fx_curve[slot*65]=0;
  f;
);
// Every Convolver slot must own a distinct valid entry: the first claimant keeps it, the others
// (invalid, duplicate, or an old save) get a free one, or become empty slots when none is left.
function conv_validate() local(k,e) (
  memset(conv_tab+400,0,CONV_NI);
  k=0; loop(42,
    fx_cfg[k*6]==10 ? (
      e=conv_entry(k);
      e>=0 && conv_tab[400+e]==0 ? conv_tab[400+e]=1 : fx_curve[k*65]=0;
    );
    k+=1;
  );
  k=0; loop(42, fx_cfg[k*6]==10 && conv_entry(k)<0 ? (conv_assign(k)<0 ? fx_cfg[k*6]=0;); k+=1;);
);
// Resonance Suppressor lane (FX type 11). Stereo output: lanes 39-41 (left) and 42-44 (right)
// of the same slot share the larger cut. The right lane runs after the left one in the same
// sample and sets the gains of both, so identical channels stay identical; an unlinked lane
// sets its own.
function sup_run(k,q,base,x,age,r,amt,lo,hi) local(na,p,o,pb,link,aa,ar,j,t,c) (
  sup_step(q,base,x,age,r,amt,lo,hi) ? (
    na=q[9]; link=0;
    k>=39 ? (
      p=k<42 ? k+3 : k-3; o=fx_st+p*32; pb=fx_buf+p*131072;
      link=o[0]==11 && o[7]>0 && o[9]==na && o[1]>0;
    );
    !(link && k<42) ? (
      aa=sup_attack(q,r); ar=sup_release(q,r);
      j=0; loop(na,
        t=base[3072+j]; link ? t=max(t,pb[3072+j]);
        c=sup_gain(base,j,t,aa,ar); sup_set(base,j,c);
        link ? sup_set(pb,j,c);
        j+=1;
      );
    );
  );
  sup_bells(q,base,x);
);
function fx_validate() (fx_cfg_validate(42); conv_validate(););
// Targets are copied once per block. Runtime state is owned by the audio thread.
function fx_prepare() local(k,q,p,t,r,n,a,b,c) (
  fx_run=484100;fx_count=484200;memset(fx_count,0,15);
  memset(fx_on,0,14); conv_cnt=0;
  k=0; loop(45,
    n=k<42 ? k : k-3; p=fx_cfg+n*6; q=fx_st+k*32;
    t=max(0,min(11,floor(p[0]))); r=n<39 ? ir : srate;
    // Empty lanes have no targets to decode or histories to advance.
    (t>0 || q[0]>0 || q[1]>0 || (p[5]>=.5 && p[1]>0)) ? (
    a=max(0,min(1,p[2])); b=max(0,min(1,p[3])); c=max(0,min(1,p[4]));
    // Compatibility for old in-memory settings; audio never writes the bank.
    t==7 ? (t=8; a=log((40*300^a)/20)/log(800); b*=24/128; c*=log(16)/log(64););
    // Convolver engines are handed out in lane order; a lane without one (or whose slot has no IR
    // yet) passes the signal. Each engine follows its slot's own impulse response.
    // (Kept in conv_tab[450 + lane] and [500 + lane], not in the lane's state: other types use it.)
    conv_tab[450+k]=-1; conv_tab[500+k]=0;
    t==10 && conv_cnt<CONV_NI ? (
      conv_tab[450+k]=conv_cnt; conv_cnt+=1;
      conv_tab[500+k]=conv_sync(conv_tab[450+k],k,conv_entry(n),k>=42,r,(p[5]>=.5 && p[1]>0) || q[1]>.000001);
    );
    q[16]=t; q[17]=p[5]>=.5 ? max(0,min(1,p[1])) : 0;
    fx_lane_targets(q,t,r,a,b,c,16000);
    (t>0 && q[17]>0) || q[1]>.000001 ? fx_on[floor(n/3)]=1;
    q[17]>0 || q[1]>0 || q[0]!=q[16] ? (
      fx_run[floor(k/3)*3+fx_count[floor(k/3)]]=k;fx_count[floor(k/3)]+=1;
    );
    );
    k+=1;
  );
);
// One sample of lane k. pressure_mode: the air pressure point (Ring Mod multiplies by 0..1).
function fx_lane(k,x,pressure_mode) local(q,t,base,n,y) (
  q=fx_st+k*32;
  fx_lane_begin(q) ? (
    t=q[0]; base=fx_buf+k*131072;
    y=t==9 ? fx_curvevol_run(q,x,fx_curve+(k<42 ? k : k-3)*65,0,1) :
      t==10 ? (
        // Lanes 0-38 are mono at the internal rate (first IR channel), 39-41 the left channel
        // and 42-44 the right at the host rate. Without an impulse response in its slot the
        // lane passes the signal (conv_sync in fx_prepare decides).
        n=conv_tab[450+k];
        n>=0 && conv_tab[500+k]==1 ? fx_convolver_run(q,x,n,conv_hb+n*CONV_BS) : x;
      ) :
      t==11 ? sup_run(k,q,base,x,q[7],q[22],q[2],q[3],q[4]) :
      fx_type_run(q,t,base,x,pressure_mode);
    x=fx_lane_end(q,x,y);
  );
  x;
);
function fx_chain(point,x,right) local(j,k,chain) (
  chain=point+(right?1:0);
  j=0; loop(fx_count[chain],
    k=fx_run[chain*3+j]; x=fx_lane(k,x,point==0); j+=1;
  );
  // Internal waves have finite headroom; the original path is untouched when off.
  point<7 ? max(-16,min(16,x)) : x;
);
