// GENERATED by make sync-lib from lib/fx/mtt_fx_types.jsfx-inc. Edit that file, then run make sync-lib; never edit this copy.
// MTT shared FX library: the type table. Import after mtt_fx_core and every type file.
// API card: lib/README.md.
@init
// Once per block, for a lane whose slot has type t (0-11, 7 already migrated to 8) at lane
// rate r, with the slot's A, B, C (0..1): the targets the lane glides to (q[18..20], Group
// Delay q[23..24]) and the lane's smoothing and wobble coefficients (q[21], q[22], q[27..30]).
// top: the highest damping frequency of Delay and Reverb in Hz (Loon 16000, Breeze 48000).
function fx_lane_targets(q,t,r,a,b,c,top) (
  t==1 ? fx_ringmod_targets(q,r,a,b,c) :
  t==2 ? fx_flanger_targets(q,r,a,b,c) :
  t==3 ? fx_chorus_targets(q,r,a,b,c) :
  t==4 ? fx_delay_targets(q,r,a,b,c,top) :
  t==5 ? fx_reverb_targets(q,r,a,b,c,top) :
  t==8 ? fx_groupdelay_targets(q,r,a,b,c) :
  t==9 ? fx_curvevol_targets(q,r,a,b,c) :
  t==10 ? fx_convolver_targets(q,r,a,b,c) :
  t==11 ? fx_suppressor_targets(q,r,a,b,c) :
  fx_saturation_targets(q,r,a,b,c);   // 6, and the unused targets of an empty lane
  q[21]=1-exp(-1/(.015*r)); q[22]=r;
  // Curve Volume wobble: slow (1.5 Hz) and faster (9 Hz) smoothed noise, scaled to unit deviation.
  q[27]=1-exp(-2*$pi*1.5/r); q[28]=sqrt(3*(2-q[27])/q[27]);
  q[29]=1-exp(-2*$pi*9/r); q[30]=sqrt(3*(2-q[29])/q[29]);
);
// One sample of the types that need nothing from the host's topology (1-8). Types 9-11 need
// the slot's curve, the lane's convolver engine or the suppressor's linking: the host calls
// fx_curvevol_run, fx_convolver_run and sup_step/sup_bells itself. Unknown types pass x.
// unipolar: see fx_ringmod_run.
function fx_type_run(q,t,base,x,unipolar) (
  t==1 ? fx_ringmod_run(q,x,unipolar) :
  t==2 ? fx_flanger_run(q,base,x) :
  t==3 ? fx_chorus_run(q,base,x) :
  t==4 ? fx_delay_run(q,base,x) :
  t==5 ? fx_reverb_run(q,base,x) :
  t==6 ? fx_saturation_run(q,x) :
  t==8 ? fx_groupdelay_run(q,base,x) :
  x;
);
// Validates the configuration of `slots` slots (fx_cfg + slot * 6) and their curves: type
// 0-11, values 0..1, NaN to 0, the 0.28 dispersion (type 7) converted to Group Delay keeping
// its frequency, stage count and Q, and a default curve for a slot without a valid one.
function fx_cfg_validate(slots) local(k,p,j,n,cv,i) (
  k=0; loop(slots,
    p=fx_cfg+k*6;
    p[0]=p[0]==p[0] ? max(0,min(11,floor(p[0]))) : 0;
    j=1; loop(5, p[j]=p[j]==p[j] ? max(0,min(1,p[j])) : 0; j+=1;);
    // Saved 0.28 dispersion: preserve physical frequency, stage count and Q.
    p[0]==7 ? (
      p[0]=8; p[2]=log((40*300^p[2])/20)/log(800);
      p[3]*=24/128; p[4]*=log(16)/log(64);
    );
    k+=1;
  );
  n=0; loop(slots,
    cv=fx_curve+n*65;
    cv[64]!=1 ? fx_curve_preset(n,0) : (i=0; loop(64, cv[i]=cv[i]==cv[i] ? max(0,min(1,cv[i])) : 0; i+=1;););
    n+=1;
  );
);
