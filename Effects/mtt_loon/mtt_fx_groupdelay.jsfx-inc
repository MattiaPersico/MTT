// GENERATED by make sync-lib from lib/fx/mtt_fx_groupdelay.jsfx-inc. Edit that file, then run make sync-lib; never edit this copy.
// MTT shared FX library: Group Delay (FX type 8; type 7, the 0.28 dispersion, is migrated to
// it by the host). Needs mtt_fx_core. API card: lib/README.md.
// A cascade of up to 128 identical RBJ all-pass sections: flat magnitude, frequency-dependent
// delay. A: centre frequency 20 Hz - 16 kHz (at most 0.4 x the rate), B: stages (0-128, the
// last one cross-faded), C: Q (0.5-32). Coefficients are smoothed per sample.
// Lane state: q[23..26] coefficients; arena: 2 x 128 transposed-direct-form-II states.
@init
function fx_groupdelay_targets(q,r,a,b,c) local(om,alpha) (
  q[18]=min(r*.4,20*800^a); q[19]=128*b; q[20]=c;
  // RBJ all-pass: numerator reverses the normalized denominator.
  // https://www.w3.org/TR/audio-eq-cookbook/#APF
  om=2*$pi*q[18]/r; alpha=sin(om)/(2*(.5*64^c));
  q[23]=-2*cos(om)/(1+alpha); q[24]=(1-alpha)/(1+alpha);
);
function fx_groupdelay_run(q,base,x) local(limit,sc,b,ap1,ap2,stages,frac,y,z,wet,j,ay) (
  // Two transposed-direct-form-II states per stage, in the existing arena.
  // Clear only the bounded cascade history; inactive stages start at zero.
  limit=128; sc=q[21]; b=q[3];
  q[7]==0 ? memset(base,0,2*limit);
  q[0]==q[16] ? (q[25]+=sc*(q[23]-q[25]); q[26]+=sc*(q[24]-q[26]););
  ap1=q[25]; ap2=q[26]; stages=floor(b); frac=b-stages;
  y=x; z=x; wet=x; j=0;
  loop(limit,
    j<ceil(b) ? (
      ay=ap2*y+base[j*2];
      base[j*2]=ap1*(y-ay)+base[j*2+1];
      base[j*2+1]=y-ap2*ay;
      y=ay; j<stages ? z=y : wet=y;
    ) : (base[j*2]=base[j*2+1]=0;);
    j+=1;
  );
  z+frac*(wet-z);
);
